# Dépendances
node_modules/
.pnp.*
.yarn/

# Build
dist/
build/
.next/
out/
*.tsbuildinfo

# Environnement — jamais de secret versionné
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
!.env.example

# Terraform — l'état contient des valeurs sensibles
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
.terraform.lock.hcl

# Clés et certificats
*.pem
*.key
*.p12
*.pfx

# Tests et couverture
coverage/
.nyc_output/
playwright-report/
test-results/

# Python — outillage de scripts/
__pycache__/
*.py[cod]

# Logs
*.log
npm-debug.log*
logs/

# Éditeurs et OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
.DS_Store
Thumbs.db

# Claude Code — les réglages partagés sont versionnés, les locaux non
.claude/settings.local.json
# État des tickets de traçabilité : propre à chaque session
.claude/.tracking/
# Journal et état des runs de jalon : propres à chaque machine
.claude/.milestone/
# Commandes ayant demandé une permission, en attente de revue
.claude/.permissions/
# Worktrees créés par /ticket
.claude/worktrees/
