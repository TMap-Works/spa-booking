# Copier en .env.local et renseigner. Ne jamais versionner de valeur réelle.
# En déployé, ces valeurs viennent d'AWS Secrets Manager, pas d'un fichier.

NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Base de données
DATABASE_URL=postgresql://spa:spa@localhost:5432/spa_dev

# Cache et verrous de réservation
REDIS_URL=redis://localhost:6379

# Authentification
JWT_SECRET=changez-moi-en-local-uniquement
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Stripe — clés de TEST en local. La clé secrète ne doit jamais atteindre le navigateur.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# AWS (local : bouchonné ou LocalStack)
AWS_REGION=eu-west-3
SES_FROM_EMAIL=no-reply@example.test
SNS_SMS_SENDER_ID=SPA
NOTIFICATIONS_QUEUE_URL=

# Réservation
DEFAULT_SLOT_INTERVAL_MINUTES=15
DEFAULT_MIN_BOOKING_NOTICE_MINUTES=60
SLOT_LOCK_TTL_SECONDS=120

# Observabilité
LOG_LEVEL=debug
