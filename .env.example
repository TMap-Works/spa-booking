# Copier en .env.local et renseigner. Ne jamais versionner de valeur réelle.
# En déployé, ces valeurs viennent d'AWS Secrets Manager, pas d'un fichier.

NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Base de données
DATABASE_URL=postgresql://spa:spa@localhost:5432/spa_dev

# Cache et verrous de réservation
REDIS_URL=redis://localhost:6379

# Authentification
# Deux secrets **distincts** d'au moins 32 caractères, sans valeur par défaut :
# l'API refuse de démarrer s'ils manquent, sont trop courts ou sont identiques.
# En local : `openssl rand -base64 48`. En déployé : AWS Secrets Manager.
JWT_SECRET=changez-moi-en-local-uniquement-32-caracteres-minimum
JWT_REFRESH_SECRET=changez-moi-aussi-et-differemment-32-caracteres-minimum
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
# Coût bcrypt : 12 partout, sauf en test où le quart de seconde par hachage
# n'achète rien.
BCRYPT_COST=12

# Stripe — clés de TEST en local. La clé secrète ne doit jamais atteindre le navigateur.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# AWS (local : bouchonné ou LocalStack)
AWS_REGION=eu-west-3
SES_FROM_EMAIL=no-reply@example.test
SNS_SMS_SENDER_ID=SPA
NOTIFICATIONS_QUEUE_URL=

# Réservation
DEFAULT_SLOT_INTERVAL_MINUTES=15
DEFAULT_MIN_BOOKING_NOTICE_MINUTES=60
SLOT_LOCK_TTL_SECONDS=120

# Observabilité
LOG_LEVEL=debug
