// Modèle de données du CDC §2.4 — les sept entités du MVP.
//
// Trois règles tiennent tout ce fichier, et aucune n'est négociable :
//
// 1. **`tenant_id` non nullable sur toute table métier**, avec clé étrangère
//    vers `tenants`. Seule `tenants` en est exemptée — c'est la racine, pas une
//    donnée d'établissement (.claude/skills/tenant-isolation/SKILL.md §1).
//    Tout index métier commence par `tenant_id`, et tout unique métier est
//    composite avec lui : deux salons ont le droit d'avoir chacun un service
//    « Massage 60 min » et une cliente « alice@example.test ».
// 2. **Aucun montant en flottant.** Un montant est un entier dans la plus petite
//    unité monétaire (`*_amount_minor`) accompagné de son code devise ISO 4217.
//    Un prix n'a pas de sens sans sa devise : les deux voyagent ensemble.
// 3. **Tout instant est un `timestamptz`**, stocké en UTC, converti à
//    l'affichage selon `tenants.timezone`. Un rendez-vous mal fuseau-horairé est
//    un bug de sévérité haute.
//
// Les identifiants sont des UUID v4 générés côté application : l'énumération
// d'identifiants séquentiels est un vecteur de fuite inter-tenant à part entière
// (tenant-isolation §4).
//
// Les suppressions sont volontairement `Restrict` : rien dans le périmètre MVP
// ne supprime un tenant, un client ou un rendez-vous — une annulation est un
// *statut*, pas un `DELETE`. L'effacement RGPD est une procédure dédiée et
// étagée, pas un effet de bord de cascade. Une seule exception, assumée :
// `ServiceStaff` est en `Cascade`, parce qu'une ligne d'affectation n'est pas une
// donnée en propre — elle ne survit ni à la prestation ni au praticien qu'elle
// relie.
//
// Deux garanties ne sont pas exprimables ici et vivent en SQL brut à la fin de la
// migration (api-module §6) :
//
// - les **clés étrangères composites `(tenant_id, id)`**, sans lesquelles une
//   ligne d'un salon pourrait référencer celle d'un autre — `tenant_id` sur la
//   table est nécessaire, il n'est pas suffisant ;
// - les **contraintes `CHECK`** qui bornent montants, durées et intervalles.
//
// Toute migration générée ensuite qui prétendrait les retirer est à corriger à la
// main avant d'être versée.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Énumérations
// ---------------------------------------------------------------------------

/// Rôle du compte — CDC §2.4 « Compte (client / staff / admin) + rôle », étendu
/// par le CDC §1.4 (« comptes staff avec rôles et permissions ») au rang
/// intermédiaire `MANAGER`.
///
/// **L'ordre des quatre libellés est signifiant.** PostgreSQL ordonne un `enum`
/// par son ordre de **déclaration**, et c'est cet ordre que rend le
/// `orderBy: { role: 'asc' }` de `listStaffAccounts`. Il est ici celui de la
/// hiérarchie d'autorisation — `CLIENT` < `STAFF` < `MANAGER` < `ADMIN` — et
/// `MANAGER` a donc été inséré *avant* `ADMIN` par la migration
/// `20260826100000_add_manager_user_role`, non ajouté en queue. Les deux ordres
/// sont verrouillés ensemble par `src/modules/identity/__tests__/roles.spec.ts`.
enum UserRole {
  CLIENT
  STAFF
  MANAGER
  ADMIN
}

/// Cycle de vie du rendez-vous. `CANCELLED` et `NO_SHOW` sont des statuts, pas
/// des suppressions : le reporting de base du MVP compte les no-shows.
enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// Qui a annulé le rendez-vous — booking-engine §5, « consigner `cancelled_at`,
/// `cancelled_by` (client / staff / système) et `cancellation_reason` ».
///
/// Ce n'est pas une redite de `UserRole` : la question posée n'est pas « quel
/// droit avait l'auteur ? » mais « de quel côté du comptoir la décision
/// vient-elle ? ». Le reporting no-show du CDC §1.4 distingue une cliente qui se
/// décommande d'un salon qui ferme sa journée, et les deux se lisent tout
/// autrement dans un taux d'annulation. Un `MANAGER` qui annule est un
/// `STAFF` de ce point de vue-là.
///
/// `SYSTEM` n'est écrit par aucune surface HTTP aujourd'hui : il nomme d'avance
/// l'annulation automatique — purge des `PENDING` jamais payés, fermeture
/// exceptionnelle propagée. Le déclarer maintenant évite d'avoir à migrer un
/// type d'énumération le jour où cette annulation-là existera ; l'y ajouter
/// ensuite aurait coûté une migration de plus pour une valeur déjà prévue.
enum AppointmentCancelledBy {
  CLIENT
  STAFF
  SYSTEM
}

/// Moyen d'encaissement au comptoir — CDC §1.4 « carte/espèces ».
///
/// **Cette énumération ne bouge pas avec #834**, et c'est la décision de
/// l'[ADR 0014](../../../docs/adr/0014-carte-au-comptoir-par-tpe.md) : le moyen
/// dit ce que la cliente a présenté — un billet ou une carte —, pas par quel
/// tuyau la carte est passée. Ce second fait est porté par
/// `PaymentCardChannel`, ci-dessous.
enum PaymentMethod {
  CARD
  CASH
}

/// Par quel tuyau une carte est passée — #834, troisième critère.
///
/// ## Un canal, et non une valeur de plus dans `PaymentMethod`
///
/// L'issue laissait le choix entre les deux. C'est le canal qui est retenu,
/// pour la raison que l'ADR 0014 développe : `method` est lu par des
/// consommateurs qui n'ont pas à connaître le tuyau — la ventilation du revenu
/// par moyen, le libellé du reçu, le filtre de rapprochement — et ajouter
/// `CARD_TERMINAL` à l'énumération aurait **changé le sens** de leur filtre
/// `CARD` en silence. Les deux faits sont orthogonaux ; le schéma les sépare.
///
/// | Valeur | Ce qu'elle désigne |
/// |---|---|
/// | `STRIPE` | l'intention en ligne du tunnel public — le seul chemin où Stripe touche la carte |
/// | `TERMINAL` | le **TPE autonome** du salon : celui de sa banque, non relié à l'application |
///
/// `payments_card_channel_check` interdit d'en porter un ailleurs que sur une
/// carte. Il n'en **exige** pas de toute carte, et la migration dit pourquoi :
/// l'exiger aurait demandé de reprendre les lignes existantes, et un `UPDATE`
/// sur une ligne antérieure à #817 se heurte à `payments_sale_required_check`,
/// posé `NOT VALID`.
enum PaymentCardChannel {
  STRIPE
  TERMINAL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// Sort d'une **demande** de remboursement, telle que le comptoir l'a formulée
/// — #63.
///
/// À ne pas confondre avec `PaymentStatus`, qui dit où en est l'encaissement :
/// celui-là est écrit par le webhook `charge.refunded` et par lui seul
/// (payments-stripe §6). Cette énumération-ci ne décrit que le cheminement de
/// l'ordre donné au prestataire.
///
/// - `PENDING` — la demande est inscrite, l'appel au prestataire n'a pas encore
///   abouti. Elle **réserve déjà son montant** dans le cumul : deux comptoirs
///   qui remboursent en même temps ne peuvent pas rendre deux fois la même
///   somme parce que le premier appel est encore en vol.
/// - `SUCCEEDED` — le prestataire a accepté et rendu sa référence `re_…`.
/// - `FAILED` — le prestataire a refusé ou n'a pas répondu. Le montant est
///   relâché : il ne compte plus dans le cumul, et la somme reste remboursable.
///
/// `SUCCEEDED` ne veut pas dire que l'argent est arrivé sur la carte : cela,
/// c'est `charge.refunded` qui le dira, et c'est lui qui met `payments` à jour.
enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// Nature d'une ligne de ticket au comptoir — CDC §1.4 « POS de base :
/// services + produits retail », #60.
///
/// Les quatre valeurs se répartissent en deux familles, et c'est cette
/// répartition qui porte la règle « le total est recalculé côté serveur » :
///
/// - `SERVICE` et `PRODUCT` **référencent une ligne du catalogue**, dont le
///   prix fait autorité. Le comptoir désigne l'article et sa quantité ; il
///   n'envoie aucun montant, et le serveur ne lui en accepterait aucun ;
/// - `TAX` et `TIP` n'ont pas d'article derrière elles. La taxe est calculée
///   par le serveur à partir de `tenants.tax_rate_bps` ; le pourboire est la
///   seule valeur qu'un humain choisit, et il n'existe nulle part ailleurs
///   pour être relu.
///
/// Elles sont des **lignes**, jamais des colonnes fondues dans un prix :
/// payments-stripe §5 l'exige, et un ticket dont la taxe serait incorporée au
/// prix de la prestation deviendrait irréconciliable avec la comptabilité du
/// salon.
enum SaleItemKind {
  SERVICE
  PRODUCT
  TAX
  TIP
}

/// Nature de l'identifiant d'entreprise d'un établissement — #818, troisième
/// critère.
///
/// Deux pays sont servis, et ils ne nomment pas la même chose : la France
/// identifie l'établissement par son `SIRET` et l'entreprise par son `SIREN` ;
/// Madagascar identifie le contribuable par son `NIF` et l'établissement par son
/// numéro `STAT`. `OTHER` — le « AUTRE » du critère — absorbe les autres pays
/// sans prétendre connaître leur plan de numérotation.
///
/// Une énumération et non une chaîne libre, parce que la **vérification** en
/// dépend : un `SIRET` se contrôle par une clé de Luhn, un `NIF` ne se contrôle
/// pas, et sans la nature il n'y a aucun moyen de savoir laquelle des deux
/// règles appliquer. Le témoin du contrat vit dans
/// `packages/shared/src/constants/receipt.ts`.
enum LegalIdType {
  SIRET
  SIREN
  NIF
  STAT
  OTHER
}

enum NotificationChannel {
  EMAIL
  SMS
}

/// Les trois messages du périmètre MVP — CDC §1.4 « Notifications ».
enum NotificationType {
  BOOKING_CONFIRMATION
  REMINDER_24H
  CANCELLATION
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// Pourquoi une adresse a cessé d'être sollicitée — #73, notifications §5.
///
/// Deux valeurs, et seulement deux, parce que seules deux issues sont
/// **définitives** au sens de SES : un rebond permanent (la boîte n'existe pas,
/// le domaine ne résout pas, le serveur refuse pour toujours) et une plainte
/// (le destinataire a cliqué « courrier indésirable »). Les autres événements de
/// remise — rebond transitoire, retard de livraison, refus du message par SES,
/// échec de rendu — ne disent rien de l'adresse : ils ne suppriment donc rien.
///
/// La distinction n'est pas cosmétique. Traiter un rebond transitoire comme
/// permanent priverait durablement une cliente de ses confirmations pour une
/// boîte pleine pendant deux jours ; l'inverse — réécrire à une adresse morte —
/// dégrade la réputation d'envoi du **domaine entier**, donc la délivrabilité
/// des rappels de tous les établissements (CDC §6, risque de délivrabilité).
enum EmailSuppressionReason {
  /// Rebond permanent : `bounceType = Permanent` dans l'événement SES.
  HARD_BOUNCE
  /// Plainte : le destinataire a signalé le message comme indésirable.
  COMPLAINT
}

/// L'état d'une livraison de webhook dans la file durable — #409.
///
/// Deux valeurs et non trois : une livraison **aboutie n'existe plus**. La
/// preuve qu'elle a eu lieu est la ligne de `processed_webhook_events`, écrite
/// dans la transaction du traitement lui-même ; en garder une seconde ici
/// ferait deux journaux de la même chose, dont l'un grossirait sans être lu.
///
/// `PENDING` couvre donc « jamais tentée », « en cours » et « en attente d'un
/// réessai » — c'est `claimed_at` et `next_attempt_at` qui les distinguent, pas
/// le statut. `DEAD` est la file d'attente morte : la borne de réessais est
/// franchie, une alerte est partie, et plus rien ne se produira sans un humain.
enum WebhookDeliveryStatus {
  PENDING
  DEAD
}

// ---------------------------------------------------------------------------
// Tenant — la racine de l'isolation
// ---------------------------------------------------------------------------

/// Établissement (salon, spa, barbershop).
///
/// Seule table sans `tenant_id` : elle *est* le tenant. Son `slug` est donc le
/// seul unique global du schéma — c'est lui qui résout l'établissement depuis
/// le sous-domaine ou l'URL des pages de réservation publiques, avant toute
/// authentification.
model Tenant {
  id String @id @default(uuid()) @db.Uuid

  slug String @unique @db.VarChar(63)
  name String @db.VarChar(160)

  /// Fuseau IANA (« Europe/Paris »), **obligatoire** : sans lui, aucun instant
  /// UTC stocké ici ne peut être rendu à l'écran. Pas de valeur par défaut —
  /// un défaut silencieux décalerait tout un agenda d'une heure.
  timezone String @db.VarChar(64)

  /// Devise par défaut de l'établissement (ISO 4217). Chaque montant porte
  /// malgré tout la sienne : celle-ci peut changer, les montants déjà encaissés
  /// non.
  defaultCurrency String @map("default_currency") @db.Char(3)

  contactEmail String? @map("contact_email") @db.VarChar(320)
  contactPhone String? @map("contact_phone") @db.VarChar(32)

  /// Adresse postale de l'établissement — CDC §1.4, « page vitrine du salon »
  /// (#343).
  ///
  /// Les cinq colonnes sont **nullables** : un salon fraîchement inscrit n'a pas
  /// encore saisi son adresse, et sa vitrine doit rester servie. C'est ce qui
  /// rend la migration purement additive — aucune ligne existante n'a de valeur
  /// à fournir.
  ///
  /// Nullables *chacune*, mais pas indépendamment : la contrainte
  /// `tenants_address_completeness_check` exige que `address_line1`, `city` et
  /// `country_code` soient les trois nulles ou les trois renseignées. Une
  /// adresse sans ville n'oriente personne, et le `PostalAddress` du JSON-LD
  /// qu'elle produirait serait une donnée structurée incomplète — ce que la
  /// page publique refuse par principe d'inventer.
  ///
  /// `address_line2` et `postal_code` restent libres : le premier est un
  /// complément, le second n'existe pas dans tous les pays.
  addressLine1 String? @map("address_line1") @db.VarChar(160)
  addressLine2 String? @map("address_line2") @db.VarChar(160)
  postalCode   String? @map("postal_code") @db.VarChar(16)
  city         String? @map("city") @db.VarChar(120)

  /// Pays en ISO 3166-1 alpha-2, majuscules — « FR », « MG ».
  ///
  /// Un code et non un nom, pour la même raison que `default_currency` est un
  /// code ISO 4217 : « France », « france » et « FRANCE » sont trois chaînes
  /// pour un seul pays, et `schema.org/addressCountry` accepte explicitement le
  /// code à deux lettres.
  countryCode String? @map("country_code") @db.Char(2)

  /// Pas de découpage des créneaux proposés, en minutes — 15 par défaut
  /// (CDC §2.3, booking-engine §3, étape 4).
  ///
  /// C'est un réglage d'établissement et non une constante : un barbershop qui
  /// enchaîne des coupes de vingt minutes et un spa dont le moindre soin dure une
  /// heure ne proposent pas la même grille. Le pas s'applique **à partir du début
  /// de chaque fenêtre de travail**, jamais depuis minuit : une fenêtre qui ouvre
  /// à 09:10 propose 09:10, 09:25, 09:40, et non 09:15.
  ///
  /// La borne basse est ce qui protège l'algorithme : un pas nul ou négatif
  /// ferait boucler indéfiniment le découpage. La contrainte
  /// `tenants_slot_interval_minutes_check` la porte en base, et le calcul la
  /// revérifie — la base est la garantie, le contrôle applicatif est le message.
  slotIntervalMinutes Int @default(15) @map("slot_interval_minutes")

  /// Délai minimum entre l'instant présent et le début d'un créneau proposable,
  /// en minutes — 60 par défaut (booking-engine §3, étape 6).
  ///
  /// Sans lui, la page publique propose un créneau qui commence dans deux
  /// minutes : le praticien n'a pas vu passer la réservation, et personne
  /// n'accueille la cliente. `0` est licite — c'est le salon qui accepte le
  /// passage immédiat —, et le filtre « créneaux dans le passé » reste alors
  /// actif de lui-même, `maintenant + 0` valant `maintenant`.
  minBookingNoticeMinutes Int @default(60) @map("min_booking_notice_minutes")

  /// Taux de taxe appliqué aux ventes au comptoir, en **points de base** —
  /// `2000` vaut 20 % (#60).
  ///
  /// En points de base, et non en pourcentage fractionnaire, pour une raison
  /// qui n'est pas de commodité : un taux à virgule serait un flottant, et le
  /// projet n'en accepte aucun sur le chemin de l'argent. Le calcul de la ligne
  /// de taxe reste alors une multiplication d'entiers suivie d'une division
  /// entière, exacte et reproductible — deux tickets identiques produisent le
  /// même centime, aujourd'hui et au prochain rapprochement.
  ///
  /// `0` par défaut, ce qui rend l'ajout de cette colonne sans effet sur les
  /// établissements déjà en base : aucune ligne de taxe n'est alors composée, et
  /// le ticket est exactement celui qu'il aurait été sans elle. La borne haute
  /// est portée par `tenants_tax_rate_bps_check` : un taux hors de `[0, 10000]`
  /// n'est pas un taux.
  ///
  /// Le MVP n'expose **aucune route** pour le régler — le paramétrage fiscal du
  /// salon relève du back-office, pas du POS. La colonne existe pour que le
  /// total soit calculable côté serveur ; sa saisie viendra avec l'écran qui la
  /// porte.
  taxRateBps Int @default(0) @map("tax_rate_bps")

  /// Raison sociale — le nom **juridique** de l'entreprise, quand il diffère de
  /// l'enseigne (#818, troisième critère).
  ///
  /// `name` est ce que la cliente lit sur la vitrine ; `legal_name` est ce
  /// qu'une pièce de caisse doit porter. « Barber Tana » et « TANA COIFFURE
  /// SARL » sont le même salon, et un ticket qui ne porte que le premier
  /// n'identifie personne au sens comptable.
  ///
  /// Nullable, comme les cinq colonnes qui suivent : un salon inscrit avant ce
  /// ticket n'a rien saisi, et son reçu doit continuer d'être servi. C'est ce
  /// qui rend la migration purement additive.
  legalName String? @map("legal_name") @db.VarChar(160)

  /// Nature de l'identifiant d'entreprise — voir `enum LegalIdType`.
  ///
  /// Indissociable de `legal_id` : `tenants_legal_id_completeness_check` exige
  /// que les deux soient nuls ou les deux renseignés. Un identifiant sans sa
  /// nature ne se vérifie pas, et une nature sans identifiant ne dit rien.
  legalIdType LegalIdType? @map("legal_id_type")

  /// L'identifiant d'entreprise lui-même — SIRET, SIREN, NIF ou STAT.
  ///
  /// Sa **forme** dépend de sa nature, et la vérification vit dans le contrat
  /// partagé (`isValidLegalId`) plutôt qu'en base : une clé de Luhn ne s'écrit
  /// pas en `CHECK`, et la coder deux fois aurait produit deux avis sur ce
  /// qu'est un SIRET valide.
  legalId String? @map("legal_id") @db.VarChar(32)

  /// Numéro de TVA intracommunautaire — « FR12345678901 ».
  ///
  /// À part de `legal_id` et non confondu avec lui : ce sont deux numéros
  /// distincts, attribués par deux administrations, et un ticket professionnel
  /// porte les deux. Le numéro français se recalcule depuis le SIREN
  /// (`isValidFrenchVatNumber`) ; les autres sont bornés en forme, faute d'une
  /// règle unique aux vingt-six plans de numérotation de l'Union.
  vatNumber String? @map("vat_number") @db.VarChar(32)

  /// Mentions imprimées en pied de ticket — conditions de remboursement,
  /// médiation de la consommation, remerciements.
  ///
  /// Cinq cents caractères : de quoi porter ce que la loi impose, pas de quoi
  /// faire du reçu un support de communication.
  receiptFooter String? @map("receipt_footer") @db.VarChar(500)

  /// Préfixe de la numérotation des pièces — le `{PRÉFIXE}` du deuxième critère,
  /// `TIC` dans `TIC-2026-000123`.
  ///
  /// `NOT NULL` avec un défaut, là où les cinq colonnes précédentes sont
  /// nullables, et la différence est de nature : les autres décrivent une
  /// identité qu'un salon a ou n'a pas encore saisie, celle-ci gouverne la
  /// **forme d'une pièce comptable** qui doit être rendue pour toute vente
  /// close, y compris celle d'un établissement qui n'a jamais ouvert son écran
  /// de réglages. Un préfixe nul aurait fait de `null-2026-000123` un numéro.
  ///
  /// Majuscules et chiffres seulement, deux à huit caractères
  /// (`tenants_receipt_prefix_check`) : le tiret est le séparateur du format, et
  /// un préfixe qui en porterait rendrait le numéro indécomposable.
  receiptPrefix String @default("TIC") @map("receipt_prefix") @db.VarChar(8)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users             User[]
  services          Service[]
  serviceCategories ServiceCategory[]
  staff             Staff[]
  serviceStaff      ServiceStaff[]
  staffSchedules    StaffSchedule[]
  closingDays       TenantClosingDay[]
  openingHours      TenantOpeningHour[]
  staffTimeOff      StaffTimeOff[]
  appointments      Appointment[]
  payments          Payment[]
  paymentRefunds    PaymentRefund[]
  products          Product[]
  sales             Sale[]
  saleItems         SaleItem[]
  receiptCounter    ReceiptCounter?
  notifications     Notification[]
  refreshTokens     RefreshToken[]

  notificationTemplates   NotificationTemplate[]
  processedWebhookEvents  ProcessedWebhookEvent[]
  stripeWebhookDeliveries StripeWebhookDelivery[]

  /// L'acte d'ouverture de ce salon, côté console plateforme (#806). La relation
  /// pointe **vers le haut** — vers l'éditeur — et non vers une donnée du salon :
  /// c'est pourquoi la table d'en face ne porte pas de `tenant_id`, voir
  /// l'ADR 0012.
  platformProvisionings PlatformTenantProvisioning[]

  @@map("tenants")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// Compte client, praticien ou administrateur.
///
/// L'unicité de l'e-mail est **par tenant** : une même personne peut être
/// cliente de deux salons sans que l'un puisse deviner l'existence de l'autre.
model User {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// L'unicité porte sur les octets : `Alice@Example.test` et
  /// `alice@example.test` cohabiteraient dans le même salon, et la recherche à
  /// la connexion ne trouverait qu'une des deux lignes. La normalisation en
  /// minuscules **avant écriture** revient au module `identity` — c'est là que
  /// se décide la forme canonique d'une adresse, pas ici.
  email String   @db.VarChar(320)
  role  UserRole

  /// Empreinte du mot de passe — jamais le mot de passe. Nullable : un client
  /// peut exister sans compte, saisi au comptoir par le staff.
  passwordHash String? @map("password_hash") @db.VarChar(255)

  firstName String  @map("first_name") @db.VarChar(80)
  lastName  String  @map("last_name") @db.VarChar(80)
  phone     String? @db.VarChar(32)

  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)

  /// Note interne du fichier client — #56, CDC §2.3 « notes » du module `crm`.
  ///
  /// « Notes internes **distinctes des informations visibles du client** » est
  /// l'énoncé du critère, et cette colonne en est la moitié durable : elle
  /// n'est écrite et lue que par le module `crm`, ne figure dans aucune
  /// projection servie au parcours public, et n'apparaît dans aucun log — le
  /// jeton `note` est dans la liste de rédaction de
  /// `common/logging/redaction.ts` (RGPD, CDC §5.1).
  ///
  /// Portée par `users` plutôt que par une neuvième table : une fiche cliente
  /// **est** une ligne `users` de rôle `CLIENT`, le CDC §1.4 borne le MVP à un
  /// « CRM client de base », et une note par fiche est exactement ce que ce
  /// périmètre demande. Un historique de notes horodatées — plusieurs lignes par
  /// fiche, avec leur auteur — est une décision de conception à part entière :
  /// elle se prendra en ADR, avec sa table, si le besoin se confirme.
  ///
  /// Nullable, et le restera : la grande majorité des fiches n'ont rien à noter.
  /// `null` se lit « aucune note », jamais « note inconnue ». La colonne existe
  /// aussi sur les comptes du personnel, faute d'une table à part — le module
  /// `crm` ne l'écrit que sur des fiches de rôle `CLIENT`, et `identity` ne la
  /// lit jamais.
  internalNote String? @map("internal_note") @db.VarChar(2000)

  /// Consentement au démarchage commercial — #81, CDC §5.1 « base légale
  /// explicite pour chaque traitement (notifications, marketing ultérieur) ».
  ///
  /// La colonne existe alors que le marketing est **hors périmètre MVP**
  /// (CDC §1.4), et c'est délibéré : le consentement se recueille au moment où
  /// la fiche se crée, pas le jour où l'on décide d'envoyer une campagne. Une
  /// base client constituée sans lui serait inexploitable a posteriori — il
  /// faudrait recontacter chacun pour le demander, ce qu'aucune base légale
  /// n'autorise justement à faire.
  ///
  /// `false` par défaut, et jamais autrement : le consentement est un acte
  /// positif (RGPD art. 4.11). Une valeur par défaut à `true` transformerait
  /// chaque fiche saisie au comptoir en consentement présumé.
  ///
  /// Ce qu'elle ne gouverne **pas** : les notifications transactionnelles —
  /// confirmation, rappel J-1, annulation. Celles-là relèvent de l'exécution du
  /// contrat, pas du consentement, et les couper romprait le service demandé.
  marketingConsent Boolean @default(false) @map("marketing_consent")

  /// Instant du dernier changement de `marketing_consent` — la **preuve** que
  /// le consentement exige (RGPD art. 7.1 : « le responsable démontre »).
  ///
  /// Un booléen seul dit l'état, jamais depuis quand ni s'il a été recueilli.
  /// Nul tant que personne ne s'est prononcé, ce qui n'est pas la même chose
  /// qu'un refus daté.
  marketingConsentAt DateTime? @map("marketing_consent_at") @db.Timestamptz(6)

  /// Quand la personne a accepté le traitement de ses données **en créant son
  /// compte** — la preuve de consentement de l'établissement (#880, CDC §5.1,
  /// RGPD art. 7.1).
  ///
  /// ## Ce que cette colonne n'est pas
  ///
  /// Ce n'est ni `marketing_consent` ni sa date : celui-là gouverne la
  /// prospection, dont le MVP ne fait rien, et il a un « refusé » à enregistrer,
  /// d'où son booléen. Celui-ci porte sur le traitement **nécessaire au
  /// service** — tenir un compte, ses coordonnées et ses rendez-vous — et n'a
  /// pas de refus à consigner : `registerRequestSchema` exige `dataConsent:
  /// true`, si bien qu'aucune ligne ne naît sans accord par cette porte. Les
  /// confondre reviendrait à couper le service à qui refuse une campagne.
  ///
  /// Même arbitrage, et même forme, qu'`appointments.data_consent_at` (#790) :
  /// un instant seul, parce que la seule valeur qu'un booléen pourrait prendre
  /// là où l'instant est posé serait `true`.
  ///
  /// ## Nullable, et ce n'est pas un relâchement
  ///
  /// `NULL` se lit « aucun accord recueilli **par cette porte-ci** », et jamais
  /// « refusé ». C'est l'état des quatre autres portes par lesquelles une ligne
  /// `users` existe : la fiche cliente saisie au comptoir (#461), le compte du
  /// personnel invité par un administrateur (#55), tout compte antérieur à cette
  /// colonne, et — celle-là mérite d'être nommée — la fiche qu'ouvre une
  /// réservation sans compte (`CrmRepository.resolveClientWithin`, #45). Un
  /// `NOT NULL DEFAULT now()` leur aurait **fabriqué** un consentement que
  /// personne n'a donné — une preuve inventée est pire que pas de preuve, elle
  /// s'oppose à la personne qu'elle prétend protéger.
  ///
  /// La quatrième n'est pas un trou dans la preuve : la visiteuse du tunnel a
  /// bien coché, et son accord est daté là où il a été donné,
  /// `appointments.data_consent_at` (#790). Ce qui est vrai, c'est qu'une
  /// colonne nulle **ici** ne veut donc pas dire « jamais consenti » : le jour
  /// où un registre énumérera les accords, il joindra les deux colonnes plutôt
  /// que de lire celle-ci seule.
  ///
  /// ## Posée par le serveur, à la création
  ///
  /// L'appelant envoie un accord, jamais une date : RGPD art. 7.1 fait porter la
  /// preuve au responsable du traitement, et une preuve horodatée par celui
  /// qu'elle engage n'en est pas une. `Timestamptz(6)` comme tout instant de ce
  /// schéma — stocké en UTC, converti au fuseau du salon à l'affichage
  /// (CLAUDE.md, ADR 0006).
  ///
  /// Aucun index : la colonne ne sert aucun prédicat de recherche, elle se lit
  /// avec la fiche qu'on regarde. Même arbitrage, et même motif, que ses deux
  /// voisines de `20260906150000`.
  dataConsentAt DateTime? @map("data_consent_at") @db.Timestamptz(6)

  /// Instant de l'anonymisation de la fiche — #81, CDC §5.1 « droit à l'oubli ».
  ///
  /// Nul sur toute fiche vivante ; daté, la ligne ne porte plus aucune donnée
  /// identifiante : nom et adresse remplacés par un pseudonyme dérivé de l'`id`,
  /// téléphone, note interne et empreinte de mot de passe vidés.
  ///
  /// **La ligne survit, et c'est le point.** `appointments.client_id` et, à
  /// travers lui, `payments` et `sales` la référencent en `Restrict` : la
  /// supprimer emporterait l'historique comptable des ventes passées, que le
  /// commerçant doit conserver. L'anonymisation retire la personne des données
  /// sans retirer les données de la comptabilité — c'est l'arbitrage que le
  /// CDC §5.1 rend possible en parlant de « suppression **ou** anonymisation ».
  ///
  /// C'est aussi cette colonne qui rend l'opération idempotente : une seconde
  /// demande sur une fiche déjà anonymisée la rend telle quelle, au lieu de lui
  /// attribuer un second pseudonyme.
  anonymizedAt DateTime? @map("anonymized_at") @db.Timestamptz(6)

  /// Instant où l'adresse de ce compte a cessé d'être sollicitée — #73,
  /// notifications §5 : « une adresse en hard bounce est marquée `suppressed` et
  /// n'est plus jamais sollicitée ».
  ///
  /// Nul sur toute adresse vivante, ce qui est le cas de l'immense majorité.
  /// Daté, plus aucun e-mail ne part vers ce compte : `findRecipientContact` rend
  /// `hasEmail: false`, donc le producteur ne compose plus d'enveloppe e-mail, et
  /// l'expédition revérifie de son côté — la suppression a pu tomber entre la
  /// publication du message et sa consommation.
  ///
  /// ## Pourquoi deux colonnes sur `users` plutôt qu'une table de suppression
  ///
  /// Parce qu'une fiche cliente **est** une ligne `users`, et que la question à
  /// laquelle ces colonnes répondent — « peut-on encore écrire à cette
  /// personne ? » — se pose exactement là où l'adresse est écrite. Une table
  /// séparée aurait dû **recopier l'adresse** pour être utile, c'est-à-dire
  /// dupliquer une donnée personnelle dans une seconde table, à faire vivre au
  /// même rythme (RGPD, CDC §5.1). C'est le raisonnement qui a déjà porté
  /// `internal_note` et `marketing_consent` ici plutôt qu'ailleurs.
  ///
  /// La suppression est donc **par établissement**, comme la ligne qui la porte :
  /// deux salons ont chacun leur fiche pour une même personne, et un rebond
  /// n'apprend rien de plus à l'un qu'à l'autre. L'ingestion des événements SES
  /// (#73) balaie tous les établissements et supprime l'adresse partout où elle
  /// est connue — la réputation d'envoi est celle du domaine, pas celle d'un
  /// salon.
  ///
  /// ## Ce qu'elles ne gouvernent pas
  ///
  /// Le canal SMS. Un rebond SES ne dit rien d'un numéro de téléphone, et SNS
  /// n'expose pas d'équivalent au périmètre du MVP.
  ///
  /// ## À reprendre le jour où l'adresse deviendra modifiable
  ///
  /// Aucune route ne permet aujourd'hui de changer `email` (le contrat
  /// `updateCustomerRequest` ne le déclare pas). Le jour où l'une le permettra,
  /// elle devra remettre ces deux colonnes à nul : la suppression porte sur une
  /// **adresse**, et une nouvelle adresse n'a rien fait pour la mériter.
  emailSuppressedAt DateTime? @map("email_suppressed_at") @db.Timestamptz(6)

  /// Ce qui a valu la suppression — nul exactement quand `emailSuppressedAt`
  /// l'est. Le back-office l'affiche sur la fiche cliente : « rebond définitif »
  /// et « plainte » n'appellent pas la même conversation au comptoir.
  emailSuppressionReason EmailSuppressionReason? @map("email_suppression_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Au plus une fiche praticien — garanti par `@@unique([tenantId, userId])`
  /// sur `Staff`. Prisma type la relation en liste parce que la cardinalité
  /// s'appuie sur un unique **composite** et non sur un unique mono-colonne :
  /// c'est le prix à payer pour qu'aucun index métier ne commence par autre
  /// chose que `tenant_id`.
  staffProfiles         Staff[]
  clientAppointments    Appointment[]   @relation("AppointmentClient")
  receivedNotifications Notification[]  @relation("NotificationRecipient")
  refreshTokens         RefreshToken[]
  /// Les tickets composés par ce compte au comptoir — #60. Nommée, comme
  /// `clientAppointments`, parce que `User` porte déjà plusieurs relations et
  /// que Prisma exige de les distinguer.
  cashedSales           Sale[]          @relation("SaleCashier")
  /// Les remboursements ordonnés par ce compte — #63. Nommée pour la même
  /// raison que `cashedSales` : `User` porte plusieurs relations et Prisma
  /// exige de les distinguer.
  requestedRefunds      PaymentRefund[] @relation("PaymentRefundRequestedBy")

  @@unique([tenantId, email])
  // Cible des clés étrangères composites `(tenant_id, id)` posées en SQL brut
  // dans la migration — c'est ce couple, et non `id` seul, qui rend impossible
  // de rattacher la ligne d'un salon à celle d'un autre. Il sert aussi de clé de
  // lecture tenant-sûre : un `findUnique` sur `{ tenantId, id }` renvoie `null`
  // pour l'id d'un autre établissement, ce qui donne le 404 attendu plutôt qu'un
  // 403 (tenant-isolation §4).
  @@unique([tenantId, id])
  // Sert « les comptes internes de l'établissement » (`listStaffAccounts`).
  // Devenu le préfixe de l'index de recherche ci-dessous, donc redondant avec
  // lui : le retirer demanderait un `DROP INDEX`, que l'additivité des
  // migrations interdit (api-module §6). Son retrait fait l'objet d'une issue de
  // suivi.
  @@index([tenantId, role])
  // Le fichier client du back-office (#56) : filtré sur `role = 'CLIENT'`,
  // ordonné par nom, et interrogé par préfixe de nom de famille. Les quatre
  // colonnes sont dans l'ordre où la requête les consomme — le tenant d'abord,
  // comme tout index de ce schéma (tenant-isolation §1), puis le rôle qui borne
  // à la clientèle, puis le couple qui trie et discrimine.
  @@index([tenantId, role, lastName, firstName])
  // La recherche par téléphone — l'axe que ni `@@unique([tenantId, email])` ni
  // l'index de nom ne couvrent. Un numéro se cherche à l'identique ou par
  // préfixe : c'est ce qu'un B-tree sert le mieux.
  @@index([tenantId, phone])
  @@map("users")
}

/// Session de rafraîchissement — une ligne par ouverture de session, et c'est
/// elle qui rend la déconnexion **invalidante**.
///
/// Un refresh token purement JWT ne se révoque pas : signé, il reste valable
/// jusqu'à son expiration, et « se déconnecter » se réduirait alors à effacer un
/// cookie que l'attaquant qui l'a volé n'effacera pas. L'état vit donc en base,
/// et le jeton n'en est que le porteur.
///
/// Ce qui est stocké n'est **pas** le jeton mais l'empreinte SHA-256 de son
/// `jti`. Une fuite de cette table ne donne donc aucune session : le `jti` est un
/// aléa de 256 bits, non devinable depuis son empreinte, et le jeton lui-même
/// doit de toute façon être signé pour être accepté. SHA-256 nu suffit ici — là
/// où un mot de passe exige bcrypt, un secret aléatoire de 256 bits n'a pas
/// d'espace de recherche à ralentir.
///
/// `token_hash` change à **chaque** rafraîchissement (rotation). Présenter un
/// `jti` qui ne correspond plus à l'empreinte courante signifie qu'un jeton déjà
/// consommé ressort : soit le vol, soit le rejeu. La session entière est alors
/// révoquée — c'est la détection de réemploi, et c'est ce qui limite la valeur
/// d'un refresh token dérobé à un seul usage.
model RefreshToken {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// Empreinte SHA-256 hexadécimale du `jti` courant — 64 caractères.
  tokenHash String @map("token_hash") @db.VarChar(64)

  /// Fin de vie de la session, indépendante de l'`exp` du jeton : c'est la base
  /// qui tranche, pas le porteur.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  /// Déconnexion, ou révocation sur détection de réemploi. Renseigné une fois,
  /// jamais remis à nul — une session révoquée ne se rouvre pas.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  /// L'empreinte que la dernière rotation a remplacée, et l'instant de cette
  /// rotation (#856). Présenté dans les secondes qui suivent, ce jeton-là est un
  /// renouvellement concurrent, pas un réemploi : il ne révoque rien.
  previousTokenHash String?   @map("previous_token_hash") @db.VarChar(64)
  rotatedAt         DateTime? @map("rotated_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // L'empreinte est unique **par tenant**, comme tout unique métier. Elle n'est
  // pas la clé de lecture — le rafraîchissement retrouve la session par son `sid`
  // — mais elle interdit que deux sessions partagent un `jti`.
  @@unique([tenantId, tokenHash])
  // Cible des clés étrangères composites — voir `User.@@unique([tenantId, id])`.
  @@unique([tenantId, id])
  // Les deux lectures du module : « les sessions vivantes de cet utilisateur »
  // (déconnexion globale, purge) et le balayage des sessions expirées.
  @@index([tenantId, userId, expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Console plateforme — l'éditeur, au-dessus des établissements
// ---------------------------------------------------------------------------
//
// Les deux modèles qui suivent sont les **seules** tables de ce schéma, avec
// `tenants`, à ne porter aucun `tenant_id`. L'exception est tranchée par
// l'ADR 0012, et le critère y est écrit : `tenant_id` protège les données
// **d'un établissement**, et une ligne qui n'appartient à aucun établissement
// n'a rien à discriminer. Lui ajouter la colonne rattacherait l'identité de
// l'éditeur à l'un des salons qu'il administre — l'inverse exact de ce que la
// règle cherche à obtenir.
//
// Trois garde-fous rendent l'exception vérifiable :
// `prisma-schema.spec.ts` les nomme dans sa liste de tables plateforme,
// `tenant-scope.extension.ts` les **refuse** au client scopé (elles ne sont
// atteignables que par `prismaUnscoped`, sous commentaire), et aucune des deux
// ne porte de donnée de client final.

/// Opérateur plateforme — l'identité de l'éditeur, hors établissement (#806).
///
/// Elle ne vit pas dans `users`, et ce n'est pas une préférence de rangement :
/// un compte de `users` porte un `tenant_id`, que `JwtAuthGuard` pose dans le
/// contexte de requête et qui **arme** le scoping Prisma. Un opérateur logé là
/// arriverait dans les contrôleurs avec la portée d'un établissement technique,
/// et la seule façon d'ouvrir un vrai salon serait de contourner cette portée
/// depuis une route authentifiée. Voir l'ADR 0012, option A.
model PlatformOperator {
  id String @id @default(uuid()) @db.Uuid

  /// Unique **globalement**, là où `users.email` ne l'est que par établissement :
  /// il n'y a qu'un espace plateforme, et deux opérateurs qui partageraient une
  /// adresse seraient deux identités pour un seul compte de messagerie.
  email String @unique @db.VarChar(320)

  /// Empreinte bcrypt — jamais le mot de passe. `NOT NULL`, contrairement à
  /// `users.password_hash` : un opérateur ne naît pas « invité », il naît par la
  /// commande d'exploitation qui lui pose son mot de passe initial.
  passwordHash String @map("password_hash") @db.VarChar(255)

  /// Secret TOTP en base32 (RFC 4648), pour la MFA que l'ADR 0012 exige.
  ///
  /// En clair, et cela se dit plutôt que se cache : un secret TOTP ne peut pas
  /// être haché, sa vérification consistant à le recalculer. Une fuite de cette
  /// table donne donc le **second** facteur, jamais le premier — qui reste sous
  /// bcrypt. Le chiffrement au repos de cette colonne est la suite naturelle ;
  /// il n'est pas au périmètre de #806.
  totpSecret String @map("totp_secret") @db.VarChar(64)

  firstName String @map("first_name") @db.VarChar(80)
  lastName  String @map("last_name") @db.VarChar(80)

  /// Ferme l'accès sans rien supprimer — même conduite que `users.is_active`.
  /// Les ouvertures de salon qu'il a signées restent, et doivent rester : c'est
  /// le journal du critère 6.
  isActive Boolean @default(true) @map("is_active")

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  provisionings PlatformTenantProvisioning[]

  @@map("platform_operators")
}

/// Journal des ouvertures d'établissement, et registre de leur idempotence —
/// critère 6 de #806.
///
/// Une ligne par salon ouvert : **qui** l'a ouvert, **quand**, et **lequel**.
/// La même ligne porte la clé `Idempotency-Key` de la requête, si bien que le
/// journal et le registre ne peuvent pas se contredire — un rejeu retrouve la
/// ligne, donc l'établissement déjà créé, et n'en ouvre pas un second.
model PlatformTenantProvisioning {
  id String @id @default(uuid()) @db.Uuid

  operatorId String           @map("operator_id") @db.Uuid
  operator   PlatformOperator @relation(fields: [operatorId], references: [id], onDelete: Restrict)

  /// L'établissement ouvert. Le champ se nomme `createdTenantId` et **jamais**
  /// `tenantId` : `tenant-scope.extension.ts` déduit du nom `tenantId` les
  /// modèles qu'il doit filtrer, et cette ligne n'appartient pas au salon
  /// qu'elle nomme — elle appartient à l'acte de l'éditeur qui l'a ouvert. Le
  /// nom n'est donc pas un contournement : c'est l'énoncé du fait.
  createdTenantId String @map("created_tenant_id") @db.Uuid
  createdTenant   Tenant @relation(fields: [createdTenantId], references: [id], onDelete: Restrict)

  /// La clé d'idempotence, unique globalement — c'est ce qui la rend utile.
  /// L'en-tête est **obligatoire** sur la création : ouvrir un salon n'est pas
  /// une opération qu'on rejoue à l'aveugle, et une clé facultative aurait rendu
  /// la garantie conditionnelle au soin de l'appelant.
  idempotencyKey String @unique @map("idempotency_key") @db.VarChar(128)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// « Les salons ouverts par cet opérateur », et le tri du journal par date.
  /// Déclaré ici parce que la migration le pose : un index qui n'existe que dans
  /// le SQL est une dérive que le prochain `prisma migrate dev` corrigerait en
  /// le **supprimant**.
  @@index([operatorId, createdAt])
  @@map("platform_tenant_provisionings")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

/// Regroupement de prestations au catalogue — « Soins du visage », « Coiffure ».
///
/// Table à part entière, et non plus la chaîne libre que portait
/// `services.category` : une chaîne recopiée à chaque prestation se renomme
/// prestation par prestation, se faute de frappe (« Massages » / « massage »),
/// et ne peut ni se désactiver ni s'ordonner. Le CRUD réclamé par #24 suppose
/// une ligne à créer, lire, modifier et retirer du catalogue.
///
/// Comme une prestation, une catégorie **ne se supprime pas** : `is_active` la
/// retire du catalogue sans casser les prestations qui la référencent, ni
/// l'historique de reporting qui les compte.
model ServiceCategory {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Unique **par tenant** : deux salons ont chacun droit à leur « coiffure ».
  slug        String  @db.VarChar(80)
  name        String  @db.VarChar(160)
  description String? @db.VarChar(2000)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  services Service[]

  @@unique([tenantId, slug])
  // Cible des clés étrangères composites — voir `User.@@unique([tenantId, id])`.
  @@unique([tenantId, id])
  @@index([tenantId, isActive])
  @@map("service_categories")
}

/// Prestation vendue par l'établissement (nom, durée, prix, catégorie).
model Service {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  slug        String  @db.VarChar(80)
  name        String  @db.VarChar(160)
  description String? @db.VarChar(2000)

  /// Ancienne catégorie en chaîne libre, **plus lue ni écrite** par le module
  /// `catalog` depuis #24 : `categoryId` l'a remplacée. La colonne survit le
  /// temps d'un déploiement — la retirer dans la migration qui cesse de la lire
  /// casserait la version encore en vol pendant un déploiement progressif
  /// (api-module §6). Son retrait fait l'objet d'une issue de suivi.
  ///
  /// Le champ Prisma est renommé, la colonne non : `@map("category")` désigne
  /// toujours `services.category`, et aucun SQL n'accompagne donc ce renommage.
  legacyCategory String? @map("category") @db.VarChar(80)

  /// Catégorie de catalogue. Nullable : une prestation non classée reste
  /// vendable, et imposer une catégorie obligerait à en inventer une avant de
  /// pouvoir créer la première prestation.
  ///
  /// `Restrict` : une catégorie encore portée par une prestation ne se supprime
  /// pas. C'est cohérent avec le reste du schéma — au catalogue on désactive,
  /// on n'efface pas.
  categoryId String?          @map("category_id") @db.Uuid
  category   ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// Durée facturée du soin, en minutes — ce que le client voit et paie.
  durationMinutes Int @map("duration_minutes")

  /// Tampons de part et d'autre du soin, en minutes : préparation de la cabine,
  /// nettoyage, remise en état. Ils ne sont **pas** facturés et n'apparaissent
  /// pas au client, mais le moteur de disponibilité les occupe : le créneau
  /// réellement bloqué sur l'agenda du praticien vaut
  /// `buffer_before + duration + buffer_after`.
  ///
  /// Valeur par défaut `0`, ce qui rend l'ajout de ces colonnes sans effet sur
  /// les prestations déjà en base : le comportement d'avant #24 est exactement
  /// celui de deux tampons nuls.
  bufferBeforeMinutes Int @default(0) @map("buffer_before_minutes")
  bufferAfterMinutes  Int @default(0) @map("buffer_after_minutes")

  /// Prix affiché : entier dans la plus petite unité (3500 = 35,00 €) et code
  /// devise explicite. Jamais de flottant sur un montant.
  priceAmountMinor Int    @map("price_amount_minor")
  priceCurrency    String @map("price_currency") @db.Char(3)

  /// Sortie du catalogue — jamais une suppression : les rendez-vous passés
  /// référencent la prestation, et le reporting doit continuer à savoir ce qui a
  /// été vendu.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignedStaff ServiceStaff[]
  appointments  Appointment[]
  /// Les lignes de ticket qui ont vendu cette prestation au comptoir (#60).
  saleItems     SaleItem[]

  @@unique([tenantId, slug])
  // Cible des clés étrangères composites — voir `User.@@unique([tenantId, id])`.
  @@unique([tenantId, id])
  @@index([tenantId, isActive])
  // Sert « les prestations de cette catégorie », la seule lecture qui filtre sur
  // ce couple — et le contrôle de référencement avant désactivation d'une
  // catégorie.
  @@index([tenantId, categoryId])
  @@map("services")
}

/// Praticien. Distinct de `User` : le compte porte l'identité et les droits, la
/// fiche praticien porte la vitrine publique et l'affectation aux prestations.
/// Un administrateur qui ne prend pas de rendez-vous n'a pas de fiche.
model Staff {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  displayName String  @map("display_name") @db.VarChar(160)
  bio         String? @db.VarChar(2000)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignedServices ServiceStaff[]
  appointments     Appointment[]
  schedules        StaffSchedule[]
  timeOff          StaffTimeOff[]

  @@unique([tenantId, userId])
  // Cible des clés étrangères composites — voir `User.@@unique([tenantId, id])`.
  @@unique([tenantId, id])
  @@index([tenantId, isActive])
  @@map("staff")
}

// ---------------------------------------------------------------------------
// Availability
// ---------------------------------------------------------------------------

/// Plage de travail **récurrente** d'un praticien : ce jour de la semaine, de
/// telle à telle heure de l'horloge du salon (CDC §1.4, gestion du personnel).
///
/// ## Une heure murale n'est pas un instant, et ne se stocke pas comme tel
///
/// C'est la seule table du schéma qui ne porte aucun `timestamptz` métier, et
/// c'est délibéré. « Ouvre à 09:00 » vaut `08:00Z` en hiver et `07:00Z` en été à
/// Paris : figer l'un des deux décalerait l'agenda six mois par an — le bug de
/// sévérité haute que CLAUDE.md interdit. La ligne ne décrit pas un point de la
/// ligne du temps, elle décrit ce que montre l'horloge.
///
/// Les bornes sont donc des **minutes écoulées depuis minuit local**, entières,
/// et non un type `TIME` : PostgreSQL ordonne et compare `time` sans difficulté,
/// mais le convertir demanderait de toute façon une date et un fuseau, et le
/// type ferait croire à un instant. L'entier ne peut se lire que pour ce qu'il
/// est. La conversion en instants UTC se fait à la volée, date par date, par
/// `TenantClockService` (#41) — jamais ici.
///
/// Borne haute **exclue**, comme celle d'un créneau : `09:00–12:00` et
/// `12:00–18:00` décrivent une journée continue, pas un chevauchement.
///
/// Plusieurs lignes par `(praticien, jour)` : c'est ainsi que se dit la coupure
/// méridienne. Leur non-recouvrement est garanti par une contrainte d'exclusion
/// `EXCLUDE USING gist` posée en SQL brut dans la migration — Prisma ne sait pas
/// l'exprimer (api-module §6).
model StaffSchedule {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// `Cascade` : une plage de travail n'est pas une donnée en propre, elle ne
  /// survit pas au praticien qu'elle décrit. Même arbitrage que `ServiceStaff`,
  /// et pour la même raison — rien d'historique ne s'y perd, les rendez-vous
  /// déjà pris portent leurs propres bornes.
  staffId String @map("staff_id") @db.Uuid
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  /// Jour de la semaine en numérotation **ISO 8601** : 1 lundi … 7 dimanche.
  /// Pas le `0`-dimanche de `Date.getDay` — `0` est *falsy*, et le praticien du
  /// dimanche disparaîtrait au premier `weekday ?? défaut`.
  weekday Int @db.SmallInt

  /// Minutes depuis minuit **local**, 0 à 1440. `540` = 09:00 à l'horloge du
  /// salon, quel que soit l'offset du jour.
  startMinute Int @map("start_minute")
  endMinute   Int @map("end_minute")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // La seule lecture du module : « les plages de ce praticien », que le calcul
  // de créneaux (#34) parcourt jour par jour.
  @@index([tenantId, staffId, weekday])
  @@map("staff_schedules")
}

/// Jour de fermeture **récurrent** de l'établissement — « fermé le dimanche ».
///
/// Une ligne par jour fermé, et rien d'autre : la fermeture est un fait de
/// l'établissement, pas de chaque praticien. La décrire ici plutôt que d'exiger
/// qu'elle soit retirée de chaque semaine de travail évite qu'un praticien
/// embauché après coup rouvre le salon à lui seul.
///
/// Les fermetures **ponctuelles** — jour férié, semaine de congés — portent une
/// date et ne sont pas de cette nature : elles relèvent des plages bloquées
/// (#33). C'est aussi pourquoi aucune colonne de date n'apparaît ici.
model TenantClosingDay {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Jour de semaine ISO — même numérotation que `StaffSchedule.weekday`.
  weekday Int @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Un jour ne se ferme qu'une fois — et l'unicité est composite avec le tenant,
  // comme tout unique métier : deux salons ferment chacun le lundi.
  @@unique([tenantId, weekday])
  @@map("tenant_closing_days")
}

/// Plage d'ouverture **annoncée** de l'établissement — « le mardi, 09:00–12:00 »
/// (#343, CDC §1.4 « page vitrine du salon : adresse, horaires, contact »).
///
/// ## Ce qu'elle n'est pas
///
/// Ni un horaire de praticien (`StaffSchedule`), ni une règle de disponibilité.
/// Le moteur de créneaux ne lit pas cette table : il part des horaires du
/// personnel et leur soustrait les absences et les jours de fermeture. Celle-ci
/// dit ce que le salon **affiche** à ses clientes, et c'est tout. Les confondre
/// ferait d'un texte de vitrine une contrainte d'agenda — un salon qui corrige
/// son affichage fermerait son planning sans l'avoir demandé.
///
/// La forme, en revanche, est délibérément celle de `StaffSchedule` : jour ISO,
/// minutes depuis minuit local, borne haute exclue. Deux représentations de la
/// même chose auraient obligé chaque écran à savoir laquelle il tient.
///
/// ## Une table, et non des colonnes
///
/// Une semaine d'ouverture n'est pas une valeur : un salon ferme entre midi et
/// deux, et rouvre parfois le soir. Il faut plusieurs plages par jour — ce qui
/// est exactement ce qu'une table exprime et qu'une colonne ne peut pas. Le
/// non-recouvrement de deux plages d'un même jour est tenu en base par une
/// contrainte d'exclusion, comme pour `staff_schedules`.
model TenantOpeningHour {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Jour de semaine ISO — même numérotation que `StaffSchedule.weekday` :
  /// 1 lundi … 7 dimanche. Pas le `0`-dimanche *falsy* de `Date.getDay`.
  weekday Int @db.SmallInt

  /// Minutes depuis minuit **local**, 0 à 1440. `540` = 09:00 à l'horloge du
  /// salon, quel que soit l'offset du jour. La borne haute est **exclue**, et
  /// `1440` est la seule façon exacte de dire « ferme à minuit ».
  startMinute Int @map("start_minute")
  endMinute   Int @map("end_minute")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // La seule lecture : « les plages de cet établissement », rendues avec la
  // vitrine. L'index est préfixé du tenant comme tout index métier.
  @@index([tenantId, weekday])
  @@map("tenant_opening_hours")
}

/// Indisponibilité d'un praticien — plage bloquée ponctuelle ou congé sur
/// plusieurs jours (CDC §2.3 « plages bloquées », #33).
///
/// ## Une seule table pour les deux
///
/// Un déjeuner de midi à treize heures et trois semaines de congés d'été ne
/// diffèrent que par leur durée : ce sont, dans les deux cas, un intervalle
/// pendant lequel le praticien ne prend pas de rendez-vous. Deux tables — l'une
/// « ponctuelle », l'autre « congé » — auraient obligé le calcul de créneaux à
/// lire les deux, à les fusionner, et à trancher les cas où une plage bloquée
/// chevauche un congé. Une table, un intervalle, une soustraction.
///
/// ## Autonome, par conception
///
/// Ce modèle ne référence **aucun** horaire récurrent : il dit quand le
/// praticien est absent, jamais quand il travaille. C'est ce qui permet de le
/// poser avant que les horaires du personnel n'existent, et surtout ce qui
/// rend la règle composable — le moteur de créneaux (#34) part des fenêtres de
/// travail et leur **soustrait** ces intervalles. Une plage bloquée hors de
/// tout horaire de travail est donc représentable et sans effet, ce qui est le
/// comportement voulu : poser un congé ne demande pas de savoir si le
/// praticien devait travailler ce jour-là.
///
/// ## Ce qui n'est pas contraint, et pourquoi
///
/// Deux indisponibilités du même praticien **peuvent** se chevaucher. Aucune
/// contrainte d'exclusion ici, contrairement à `appointments` : deux
/// rendez-vous simultanés sont une faute — deux clients devant une seule paire
/// de mains —, deux absences simultanées ne sont que la même absence dite deux
/// fois. Le moteur les fusionne avant de soustraire ; les interdire aurait fait
/// échouer en 409 le geste anodin d'étendre un congé en en posant un second.
model StaffTimeOff {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  staffId String @map("staff_id") @db.Uuid
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Restrict)

  /// Bornes de l'absence, en UTC, borne haute **exclue** — la même convention
  /// que `appointments`. Un congé « du 3 au 5 » se pose donc de minuit local le
  /// 3 à minuit local le 6, et les deux instants se calculent avec le fuseau du
  /// tenant : le client envoie des dates-heures à offset explicite, jamais une
  /// date nue que le serveur aurait à interpréter.
  ///
  /// `CHECK ("ends_at" > "starts_at")` est posé en SQL brut dans la migration,
  /// pour la même raison que sur `appointments` : un intervalle vide ne
  /// soustrait rien et resterait invisible du moteur de créneaux, alors que
  /// l'utilisateur croirait avoir bloqué son agenda.
  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(6)

  /// Motif, **facultatif et strictement interne** : « congé maternité »,
  /// « formation », « rendez-vous médical ». Il ne sort jamais du back-office —
  /// la projection que le moteur de disponibilité consomme ne le sélectionne
  /// pas, et aucune route publique ne lit cette table. Nullable parce qu'une
  /// absence n'a pas à se justifier pour être posée, et qu'un motif obligatoire
  /// se remplirait de « x » au bout d'une semaine.
  ///
  /// `VARCHAR(500)` — la largeur des motifs du schéma (`cancellation_reason`,
  /// `failure_reason`) : c'est une phrase, pas une note de dossier.
  reason String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Cible des clés étrangères composites — voir `User.@@unique([tenantId, id])`.
  @@unique([tenantId, id])
  // La lecture du moteur de créneaux : « les absences de ces praticiens sur
  // cette fenêtre ». `starts_at` en troisième position parce que la borne de
  // fenêtre porte dessus (`starts_at < to`), et que `staff_id` est toujours
  // connu quand on interroge — le moteur résout ses praticiens candidats avant.
  @@index([tenantId, staffId, startsAt])
  // La lecture du back-office : « toutes les absences de l'établissement sur ce
  // mois », tous praticiens confondus, telle que l'affiche le planning.
  @@index([tenantId, startsAt])
  @@map("staff_time_off")
}

/// Affectation N–N « ce praticien pratique cette prestation ».
///
/// Table de jonction **explicite** et non implicite : une relation implicite de
/// Prisma ne porterait pas de `tenant_id`, et il n'y aurait alors rien à quoi
/// accrocher la frontière.
///
/// Porter la colonne ne suffit pourtant pas : les clés étrangères que Prisma
/// génère ici sont mono-colonne (`service_id` → `services(id)`), donc muettes sur
/// le tenant. Ce sont les clés composites `(tenant_id, service_id)` et
/// `(tenant_id, staff_id)`, posées en SQL brut dans la migration, qui rendent
/// réellement impossible d'affecter le praticien d'un salon à la prestation d'un
/// autre.
model ServiceStaff {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  serviceId String  @map("service_id") @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  staffId String @map("staff_id") @db.Uuid
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, serviceId, staffId])
  @@index([tenantId, staffId])
  @@map("service_staff")
}

// ---------------------------------------------------------------------------
// Appointments
// ---------------------------------------------------------------------------

/// Rendez-vous. Le cœur de la boucle de valeur : réserver → confirmer →
/// honorer → encaisser → mesurer.
///
/// `starts_at` et `ends_at` sont des instants UTC. La contrainte d'exclusion
/// anti-double-réservation (`EXCLUDE USING gist`) porte sur ce couple. Elle
/// n'est pas exprimable en Prisma et vit en SQL brut, dans la migration
/// `20260827120000_add_appointment_exclusion` (#31, ADR 0002). Les index posés
/// ici sont ceux dont le moteur de disponibilité et le calendrier admin ont
/// besoin ; celui qui porte la contrainte est créé par la contrainte elle-même.
///
/// `CHECK ("ends_at" > "starts_at")` est déjà en base, dans la migration : un
/// intervalle vide (`ends_at = starts_at`) ne chevauche rien et passerait sous
/// la contrainte d'exclusion sans la déclencher — deux réservations sur le même
/// praticien au même instant.
model Appointment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  clientId String @map("client_id") @db.Uuid
  client   User   @relation("AppointmentClient", fields: [clientId], references: [id], onDelete: Restrict)

  staffId String @map("staff_id") @db.Uuid
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Restrict)

  serviceId String  @map("service_id") @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  /// La référence citable — `RDV-8F3K-27` (#796).
  ///
  /// C'est le code que la cliente lit sur sa confirmation, retrouve dans son
  /// e-mail, et dicte au téléphone ; c'est celui que le comptoir résout. Il
  /// n'est **pas** l'identifiant : `id` est un UUID v4 qui ne se dicte pas, et
  /// une référence de six symboles ne peut pas être une clé primaire exposée —
  /// elle s'énumère (tenant-isolation §4).
  ///
  /// ## Pourquoi une colonne, et non une dérivation de `id`
  ///
  /// #736 la calculait côté front à partir de l'identifiant : aucune migration,
  /// mais un espace de `32⁴ × 100` valeurs que **rien ne contraignait**. Deux
  /// rendez-vous d'un même salon pouvaient porter la même référence, ce qui est
  /// sans conséquence tant qu'elle sert à reconnaître son propre rendez-vous sur
  /// un écran — et inacceptable dès qu'on la résout, puisque le comptoir
  /// désignerait alors la mauvaise cliente. L'unicité est ici une contrainte du
  /// moteur, pas une probabilité.
  ///
  /// ## Unique **par établissement**, jamais globalement
  ///
  /// `@@unique([tenantId, reference])`, comme tout unique métier de ce schéma
  /// (tenant-isolation §1). Deux salons ont le droit de tirer le même code : ils
  /// ne se citent pas l'un à l'autre, et une unicité globale aurait fait
  /// dépendre le tirage d'un salon du volume de tous les autres.
  ///
  /// Onze caractères exactement, `RDV-XXXX-NN`. `VarChar(11)` plutôt que `Char`
  /// : la largeur est fixe par construction, et un complément par espaces sur un
  /// code qu'on compare à l'égalité n'apporte rien qu'un piège.
  reference String @db.VarChar(11)

  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(6)

  /// L'intervalle occupé, `[starts_at, ends_at)` — **colonne générée**, écrite
  /// par PostgreSQL et par personne d'autre. C'est elle que la contrainte
  /// d'exclusion `appointments_no_overlap` compare avec `&&`.
  ///
  /// `Unsupported` parce que Prisma ne connaît pas les types intervalle : le
  /// champ n'est ni lisible ni écrivable par le client, ce qui est exactement le
  /// régime voulu — `GENERATED ALWAYS` refuserait de toute façon toute écriture.
  /// Il est déclaré ici pour une seule raison, et elle est décisive : sans lui,
  /// le prochain `prisma migrate dev` verrait une colonne inconnue en base et
  /// produirait une migration qui la **retire**, emportant la contrainte avec
  /// elle. Relevé, schéma en main :
  /// `prisma migrate diff` sans ce champ écrit `ALTER TABLE "appointments" DROP
  /// COLUMN "time_range";`.
  ///
  /// Le déclarer supprime ce retrait, mais **pas toute dérive** : Prisma ne sait
  /// pas qu'une colonne est générée, lit son expression comme une valeur par
  /// défaut, et écrit alors `ALTER TABLE "appointments" ALTER COLUMN
  /// "time_range" DROP DEFAULT;` dans toute migration qu'il génère ensuite.
  /// PostgreSQL refuse cette instruction — *column "time_range" of relation
  /// "appointments" is a generated column* —, donc la migration produite par
  /// `npm run db:migrate` ne s'applique pas telle quelle : **cette ligne-là est
  /// à supprimer du fichier généré**, comme le sont déjà les `DROP CONSTRAINT`
  /// des clés étrangères composites, invisibles à Prisma pour la même raison.
  /// L'échec est bruyant et se corrige en une ligne ; le retrait silencieux de
  /// la colonne, lui, emportait la garantie anti-double-réservation.
  ///
  /// Optionnel au sens de Prisma, non nullable en pratique : `starts_at` et
  /// `ends_at` sont `NOT NULL`, donc l'intervalle l'est aussi. L'optionalité est
  /// ce qui permet à Prisma d'omettre le champ des entrées de création.
  timeRange Unsupported("tstzrange")? @map("time_range")

  status AppointmentStatus @default(PENDING)

  /// Prix figé à la réservation : le tarif du catalogue peut changer ensuite,
  /// le montant dû par ce client-là, non.
  priceAmountMinor Int    @map("price_amount_minor")
  priceCurrency    String @map("price_currency") @db.Char(3)

  clientNote String? @map("client_note") @db.VarChar(2000)
  staffNote  String? @map("staff_note") @db.VarChar(2000)

  /// Quand la cliente a accepté le traitement de ses données — la **preuve de
  /// consentement** du salon (#790, CDC §5.1, RGPD art. 7.1).
  ///
  /// ## Pourquoi un instant seul, là où `users` porte un booléen **et** un instant
  ///
  /// Parce que les deux consentements n'ont pas le même nombre d'états.
  /// `users.marketing_consent` peut être refusé — il faut donc distinguer
  /// « refusé » de « jamais demandé », et c'est ce que le booléen fait. Celui-ci
  /// n'a pas de « refusé » à enregistrer : la route publique **n'écrit aucune
  /// ligne** sans accord (`dataConsentSchema`, contrat partagé). Un booléen
  /// n'aurait donc jamais valu autre chose que `true` partout où cet instant est
  /// posé, c'est-à-dire redit la même chose une seconde fois — et une seconde
  /// écriture d'une même règle est ce qui finit par diverger.
  ///
  /// `NULL` se lit « aucun accord recueilli en ligne », jamais « refusé » : c'est
  /// le cas du rendez-vous saisi **au comptoir** (#461), où la cliente n'a coché
  /// aucune case et où le salon répond de sa base légale autrement.
  ///
  /// ## Posé par le serveur, à l'insertion
  ///
  /// L'appelant envoie un accord, jamais une date : RGPD art. 7.1 fait porter la
  /// preuve au responsable de traitement, et une preuve horodatée par celui
  /// qu'elle engage n'en est pas une. `Timestamptz(6)` comme tout instant de ce
  /// schéma — stocké en UTC, converti au fuseau du salon à l'affichage
  /// (CLAUDE.md, ADR 0006).
  ///
  /// ## Recopié par le report
  ///
  /// Un report (#39) crée une ligne neuve et annule l'ancienne. L'accord suit le
  /// rendez-vous déplacé, comme `staff_note` : il a bien été donné, et le perdre
  /// ferait disparaître la preuve au premier changement d'heure.
  ///
  /// Aucun index : cette colonne ne sert aucun prédicat de recherche. Elle se lit
  /// une ligne à la fois, par la clé du rendez-vous qu'on regarde. Même
  /// arbitrage, et même motif, que les colonnes de `20260906150000`.
  dataConsentAt DateTime? @map("data_consent_at") @db.Timestamptz(6)

  /// Traçabilité de l'annulation — #40, booking-engine §5.
  ///
  /// Les trois colonnes se lisent ensemble, et `cancelled_at` est celle qui les
  /// gouverne : nulle, le rendez-vous n'a jamais été annulé et les deux autres
  /// n'ont aucun sens. Le service d'annulation les écrit d'un seul geste.
  ///
  /// `cancelled_by` reste nullable après #40, et c'est délibéré : le report
  /// (#39) annule lui aussi la ligne d'origine, sans qu'il y ait là d'auteur
  /// d'annulation à nommer — ce n'est pas un abandon, et ce qui le dit est le
  /// `rescheduled_from_id` que porte le successeur. Un `NOT NULL` aurait obligé
  /// à ranger le report sous l'un des trois auteurs, et à fausser le taux
  /// d'annulation d'autant.
  ///
  /// `cancellation_reason` est un **texte libre saisi par un humain** : il ne
  /// part dans aucun événement de domaine ni dans aucun journal (RGPD, CDC
  /// §5.1). Qui en a besoin relit la ligne.
  cancelledAt        DateTime?               @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy        AppointmentCancelledBy? @map("cancelled_by")
  cancellationReason String?                 @map("cancellation_reason") @db.VarChar(500)

  /// Le rendez-vous que celui-ci **remplace** — la chaîne de report (#39,
  /// booking-engine §5).
  ///
  /// Un report n'est pas un `UPDATE` des dates en place : c'est une annulation
  /// suivie d'une création, et cette colonne est ce qui relie les deux. Sans
  /// elle, l'historique de la cliente montrerait un rendez-vous annulé et un
  /// rendez-vous sans passé, au lieu d'un déplacement.
  ///
  /// Elle porte aussi une raison technique : la contrainte d'exclusion refuse
  /// une mise à jour de dates pourtant légitime dès que le nouvel intervalle
  /// chevauche l'ancien. Annuler puis créer contourne le refus **sans
  /// l'affaiblir** — la ligne annulée quitte l'index partiel, l'insertion est
  /// jugée sur le reste de l'agenda.
  ///
  /// Nullable, et le restera : la grande majorité des rendez-vous ne sont le
  /// report de rien. `null` se lit « pris directement », jamais « inconnu ».
  rescheduledFromId String?      @map("rescheduled_from_id") @db.Uuid
  rescheduledFrom   Appointment? @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id], onDelete: Restrict)

  /// Les rendez-vous qui remplacent celui-ci. Une liste au sens de Prisma, au
  /// plus un élément en pratique : un rendez-vous n'est reportable qu'une fois,
  /// puisque le report le laisse `CANCELLED` et qu'un rendez-vous annulé n'est
  /// plus reportable. C'est le service qui tient cet invariant, par une écriture
  /// conditionnelle sur le statut — voir `AppointmentsRepository.reschedule`.
  rescheduledTo Appointment[] @relation("AppointmentReschedule")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Au plus un encaissement — garanti par `@@unique([tenantId, appointmentId])`
  /// sur `Payment`, pour la même raison que `User.staffProfiles`.
  payments      Payment[]
  notifications Notification[]
  /// Les tickets de comptoir rattachés à ce rendez-vous (#60).
  ///
  /// Une liste, et **sans unique** en regard : le CDC autorise expressément la
  /// vente autonome, et rien n'interdit qu'une cliente reparte avec un flacon
  /// facturé sur un second ticket après le soin. Un `@@unique` aurait interdit
  /// ce geste ordinaire pour ne protéger d'aucun risque — c'est `payments` qui
  /// porte l'unicité de l'**encaissement**, laquelle est une autre question.
  sales         Sale[]

  // Cible des clés étrangères composites — voir `User.@@unique([tenantId, id])`.
  @@unique([tenantId, id])
  // La référence citable, unique **par établissement** (#796). Cet index est à
  // la fois la garantie d'unicité et le chemin de la résolution : « quel
  // rendez-vous porte RDV-A5HY-14 ? » est une lecture par clé, jamais un
  // parcours. C'est ce qui sépare cette voie de la dérivation de #736, qui
  // n'aurait pu répondre qu'en recalculant la référence de chaque ligne.
  @@unique([tenantId, reference])
  @@index([tenantId, startsAt])
  @@index([tenantId, staffId, startsAt])
  @@index([tenantId, clientId, startsAt])
  @@index([tenantId, status, startsAt])
  // Remonter la chaîne de report — « quel rendez-vous a remplacé celui-ci ? »,
  // la question que pose l'historique client (#47). Préfixé de `tenant_id`
  // comme tout index de ce schéma (tenant-isolation §1).
  @@index([tenantId, rescheduledFromId])
  // Volume de rendez-vous **par prestation** sur une fenêtre — le troisième axe
  // du reporting de base (#74, CDC §1.4). Les deux autres étaient déjà servis :
  // par praticien par `(tenant_id, staff_id, starts_at)`, par période par
  // `(tenant_id, starts_at)`. Celui-ci manquait, et sans lui l'agrégat par
  // service parcourait toute la fenêtre du salon pour la regrouper ensuite.
  @@index([tenantId, serviceId, startsAt])
  @@map("appointments")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

/// Transaction d'encaissement — rendez-vous ou vente retail au comptoir.
///
/// **Aucune donnée de carte n'atterrit ici** : la tokenisation se fait côté
/// client vers Stripe, et le serveur ne conserve que des références opaques du
/// prestataire. Pas de PAN, pas de cryptogramme, pas de date d'expiration —
/// c'est ce qui maintient le périmètre PCI en SAQ A
/// (.claude/skills/payments-stripe/SKILL.md).
model Payment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Le rendez-vous que l'**intention en ligne** vise, ou `null`.
  ///
  /// `@@unique([tenantId, appointmentId])` tient toujours, et il tient
  /// exactement ce pour quoi il a été posé : *une* intention Stripe par
  /// rendez-vous. Deux appels concurrents à `POST
  /// /appointments/:id/payment-intent` rendent la même (`payments.service.ts`),
  /// et c'est la base qui tranche la course — jamais une relecture applicative.
  ///
  /// ## Ce que le comptoir n'écrit plus ici depuis #817
  ///
  /// Rien. Un règlement de comptoir désigne sa **vente** (`sale_id`), et c'est
  /// la vente qui porte le rendez-vous. La raison est arithmétique : le
  /// quatrième critère de #817 veut qu'un ticket de 78,00 € se règle en
  /// 50,00 € d'espèces puis 28,00 € par TPE, donc qu'une vente porte
  /// **plusieurs** encaissements ; deux lignes portant le même
  /// `appointment_id` se heurteraient à l'unique ci-dessus.
  ///
  /// La colonne reste donc lisible — le premier critère de #817 l'exige — et
  /// elle reste écrite par le seul chemin qui ait besoin de son unicité. Le
  /// rendez-vous d'un règlement de comptoir se lit par `sale_id → sales.
  /// appointment_id`, et c'est cette résolution que `PaymentTransaction` sert
  /// à l'API. PostgreSQL autorisant autant de lignes nulles qu'on veut sous une
  /// contrainte d'unicité, ces lignes-là ne se gênent entre elles ni avec les
  /// ventes retail.
  appointmentId String?      @map("appointment_id") @db.Uuid
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  /// **La pièce que ce règlement solde** — #817, CDC §2.4 : « Payment —
  /// Transaction (montant, moyen, statut) — 1–1 vers Appointment *ou vente
  /// POS* ». Le schéma ne portait que la première moitié de cette phrase.
  ///
  /// ## Ce que l'absence de cette colonne rendait représentable
  ///
  /// Une vente sans le moindre encaissement possible — onze des douze tickets
  /// de Barber Tana —, et un règlement de rendez-vous sans pièce à imprimer :
  /// le constat de #817, relevé sur `spa_dev`. Le revenu s'en déduisait sur les
  /// seuls `payments`, si bien qu'une vente de produits n'entrait **jamais** au
  /// reporting, et qu'un ticket de 106,80 € n'y comptait que pour les 65,00 €
  /// de l'encaissement adossé à son rendez-vous.
  ///
  /// ## Nullable dans Prisma, obligatoire en base pour toute ligne neuve
  ///
  /// La colonne est `String?` ici, et c'est la seule forme qui permette à la
  /// migration d'être additive : les lignes déjà écrites n'ont pas de vente, et
  /// aucune valeur par défaut ne peut en inventer une. L'obligation est portée
  /// par `payments_sale_required_check`, posé **`NOT VALID`** : PostgreSQL
  /// l'applique à toute écriture nouvelle sans relire l'existant. Le troisième
  /// critère de #817 est donc tenu par la base — « tout nouveau paiement porte
  /// une vente » — pendant que le script de reprise
  /// (`pos.sale-backfill.ts`) rattrape les anciennes.
  ///
  /// La clé étrangère est **composite** — `(tenant_id, sale_id)` vers
  /// `sales (tenant_id, id)` — et non la colonne seule : sans elle, un salon
  /// pourrait rattacher son encaissement au ticket d'un autre
  /// (tenant-isolation §1). La déclaration Prisma ne porte que `sale_id` ;
  /// le couple vit en SQL brut dans la migration, comme pour `payment_refunds`
  /// et `sale_items` (api-module §6).
  saleId String? @map("sale_id") @db.Uuid
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: Restrict)

  amountMinor         Int    @map("amount_minor")
  refundedAmountMinor Int    @default(0) @map("refunded_amount_minor")
  currency            String @db.Char(3)

  /// Ce que la cliente a **tendu** en espèces — #818, cinquième critère,
  /// « règlements : moyen, montant, et monnaie rendue pour les espèces ».
  ///
  /// La monnaie rendue était calculée à la volée par `settlement.rules.ts` puis
  /// rendue dans la réponse du règlement, et **perdue** : rien en base ne la
  /// portait, si bien qu'un reçu réimprimé une heure plus tard ne pouvait plus
  /// la dire. Elle ne se stocke pas pour autant — elle se **déduit** de
  /// `tendered − amount`, et stocker les deux aurait rendu représentable une
  /// monnaie incohérente avec le billet.
  ///
  /// Nullable, et elle le restera : la grande majorité des règlements n'ont rien
  /// à tendre — une carte débite le montant exact, et des espèces d'appoint
  /// laissent `tendered = amount`. `payments_tendered_amount_minor_check` borne
  /// les deux faits qui comptent : seul un règlement en espèces peut en porter
  /// un, et un billet tendu n'est jamais inférieur à ce qu'il règle.
  tenderedAmountMinor Int? @map("tendered_amount_minor")

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  /// Par quel tuyau la carte est passée — #834, troisième critère.
  ///
  /// `STRIPE` pour l'intention du tunnel en ligne, `TERMINAL` pour le TPE
  /// autonome du salon. **Nul sur les espèces** :
  /// `payments_card_channel_check` interdit qu'un billet se voie attribuer un
  /// tuyau, faute de quoi le rapprochement compterait un passage au terminal qui
  /// n'a pas eu lieu.
  ///
  /// ## Une carte au canal nul, et pourquoi elle reste représentable
  ///
  /// La contrainte est une **implication**, pas une équivalence : elle n'exige
  /// pas le canal de toute carte. La raison est écrite dans la migration —
  /// l'exiger aurait demandé de reprendre les lignes `CARD` existantes, et un
  /// `UPDATE` sur une ligne antérieure à #817 se heurte à
  /// `payments_sale_required_check`, posé `NOT VALID`, qui s'applique à toute
  /// mise à jour d'une ligne ancienne. La migration aurait échoué sur toute base
  /// où `pos.sale-backfill.ts` n'a pas tourné, et la CI ne l'aurait pas vu — sa
  /// base est neuve, donc vide.
  ///
  /// Une carte sans canal ne peut donc qu'être **antérieure à #834**, c'est-à-dire
  /// une intention Stripe : le TPE n'existait pas, et les deux seuls chemins
  /// d'écriture d'une carte posent désormais leur canal. C'est ce que
  /// `settlementMeanOf` énonce en la repliant sur `CARD_ONLINE`.
  cardChannel PaymentCardChannel? @map("card_channel")

  /// Le numéro du ticket ou de l'autorisation du TPE — #834, deuxième critère.
  ///
  /// **Ce n'est pas une donnée de carte**, et c'est la seule raison pour
  /// laquelle la colonne peut exister : une référence de transaction de
  /// terminal est un identifiant opaque émis par la banque du salon, du même
  /// rang qu'un `pi_…` (payments-stripe §1). Ce qu'elle ne doit jamais porter
  /// — un PAN dicté par la cliente — est refusé en 400 à la frontière HTTP par
  /// le contrôle de Luhn de `terminal-reference.ts`, et la borne de 32
  /// caractères alphanumériques y ajoute une seconde barrière de forme.
  ///
  /// Facultative : le caissier n'a pas toujours le ticket du terminal sous la
  /// main, et refuser le règlement pour cela aurait bloqué la caisse sur un
  /// champ de confort. `payments_terminal_reference_check` interdit en revanche
  /// d'en porter une ailleurs que sur un règlement au terminal.
  terminalReference String? @map("terminal_reference") @db.VarChar(32)

  /// La clé d'idempotence du règlement de comptoir — #834, quatrième critère.
  ///
  /// Elle est choisie par l'appelant et **exigée** par
  /// `POST /sales/{saleId}/payments` : cette route n'est pas rejouable par
  /// construction — deux règlements de 25,00 € sur le même ticket sont deux
  /// gestes distincts —, si bien que rien d'autre ne peut distinguer la double
  /// soumission d'un double geste. C'est l'appelant qui le sait, et la clé est
  /// la façon dont il le dit.
  ///
  /// L'unique est **par ticket** et non par établissement
  /// (`@@unique([tenantId, saleId, idempotencyKey])`) : la clé dédoublonne une
  /// soumission à *ce* ticket, et la même clé employée sur deux ventes décrit
  /// deux opérations différentes. La portée par établissement aurait exigé un
  /// code d'erreur de conflit inter-ventes que le contrat partagé ne porte pas.
  ///
  /// Nulle sur tout ce que le comptoir n'inscrit pas par cette route —
  /// l'intention en ligne, le règlement d'un rendez-vous par
  /// `POST /payments/cash`, et les lignes antérieures. PostgreSQL admettant
  /// autant de nuls qu'on veut sous un unique, elles ne se gênent pas.
  idempotencyKey String? @map("idempotency_key") @db.VarChar(128)

  /// Références Stripe. `provider_payment_intent_id` est unique **par tenant**,
  /// ce qui rend l'écriture idempotente une fois le tenant connu — mais un
  /// webhook Stripe n'arrive qu'avec `pi_xxx`. Le module `payments` devra donc
  /// résoudre le tenant avant de chercher (métadonnée d'intention, ou point
  /// d'entrée de webhook par établissement) : un index non préfixé de
  /// `tenant_id` n'est pas une option ici.
  providerPaymentIntentId String? @map("provider_payment_intent_id") @db.VarChar(255)
  providerChargeId        String? @map("provider_charge_id") @db.VarChar(255)

  capturedAt DateTime? @map("captured_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Les remboursements demandés sur cet encaissement — #63. Leur somme borne
  /// ce qui reste remboursable ; `refunded_amount_minor` ci-dessus, lui, est ce
  /// que le prestataire a confirmé par webhook.
  refunds PaymentRefund[]

  @@unique([tenantId, appointmentId])
  @@unique([tenantId, providerPaymentIntentId])
  // La clé d'idempotence du règlement de comptoir — #834. Portée au **ticket**,
  // voir `idempotencyKey` ci-dessus : c'est ce qui rend la double soumission
  // détectable sans qu'une même clé employée sur deux ventes devienne un conflit.
  @@unique([tenantId, saleId, idempotencyKey])
  // Cible des clés étrangères composites — voir `User.@@unique([tenantId, id])`.
  // Posé par #63 : `payment_refunds` référence l'encaissement, et la référence
  // doit embarquer le tenant pour qu'un remboursement d'un salon ne puisse pas
  // se rattacher à l'encaissement d'un autre.
  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, createdAt])
  // La journée de caisse du reporting (#74) se lit sur `captured_at`, l'instant
  // où l'argent a été pris — jamais sur `created_at`, qui ne date que
  // l'ouverture de l'encaissement. Un règlement ouvert à 23 h 58 et capturé à
  // 00 h 03 appartient au lendemain, et les deux index ci-dessus le rangeraient
  // la veille. Le statut précède la date parce que l'agrégat ne somme que les
  // encaissements aboutis : `SUCCEEDED`, `PARTIALLY_REFUNDED`, `REFUNDED`.
  @@index([tenantId, status, capturedAt])
  // « Qu'a-t-on déjà encaissé sur ce ticket ? » — la somme que le règlement
  // relit avant d'inscrire une ligne de plus (#817), et la jointure sur
  // laquelle le revenu du reporting s'appuie désormais.
  @@index([tenantId, saleId])
  @@map("payments")
}

/// Un remboursement demandé au comptoir — #63, CDC §4.9 et payments-stripe §6.
///
/// ## Une table, et non trois colonnes sur `payments`
///
/// Parce que le remboursement **partiel** est explicitement au périmètre : un
/// encaissement peut en recevoir plusieurs, et trois colonnes n'en garderaient
/// que le dernier. Or le critère de #63 est « qui, quand, pourquoi » — au
/// pluriel, sans quoi la trace du premier geste se perdrait au deuxième.
///
/// ## Ce qu'elle porte, et pourquoi chaque colonne
///
/// | Colonne | Le critère qu'elle sert |
/// |---|---|
/// | `requested_by_user_id` | **qui** — le compte du jeton vérifié, jamais un identifiant du corps |
/// | `created_at` | **quand** — l'instant de la demande, en UTC |
/// | `reason` | **pourquoi** — texte libre du comptoir, qui ne quitte jamais notre base |
/// | `amount_minor`, `currency` | de quoi rapprocher, en entiers et devise explicite |
/// | `provider_refund_id` | `re_…`, la ligne du relevé du prestataire |
///
/// ## Le motif ne part pas chez le prestataire
///
/// `reason` est saisi par une personne et peut nommer la cliente. Les
/// métadonnées envoyées avec l'ordre ne portent donc que des identifiants
/// opaques (CDC §5.1) : le texte reste ici, où le rapprochement le lit.
///
/// ## Aucune donnée de carte, ici non plus
///
/// Ni marque, ni quatre derniers chiffres, ni date d'expiration : il n'y a
/// nulle part où en ranger (payments-stripe §1). On rembourse une **intention**
/// désignée par sa référence opaque, pas une carte.
model PaymentRefund {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  paymentId String  @map("payment_id") @db.Uuid
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  /// Montant rendu, entier dans la plus petite unité, jamais un type à virgule.
  ///
  /// Il est le seul montant du module que l'appelant ait le droit de fixer, et
  /// c'est assumé : contrairement au prix d'une prestation, un remboursement
  /// partiel n'existe dans aucune table à relire — une personne le décide au
  /// comptoir, comme le pourboire du ticket (#60). Il est donc **borné côté
  /// serveur** : `payment_refunds_amount_minor_check` interdit le zéro et le
  /// négatif, et le service refuse tout ce qui ferait dépasser le cumul.
  amountMinor Int    @map("amount_minor")
  currency    String @db.Char(3)

  /// Le motif, tel que le comptoir l'a écrit. `NOT NULL` : un remboursement
  /// sans raison n'est pas rapprochable, et le critère de #63 le nomme.
  reason String @db.VarChar(500)

  /// Le compte qui a ordonné le remboursement — le « qui » du critère.
  ///
  /// `NOT NULL`, et il vient du jeton vérifié : l'accepter du corps aurait
  /// laissé n'importe quel poste rembourser sous le nom d'un autre, ce qui est
  /// exactement ce que la traçabilité cherche à établir.
  requestedByUserId String @map("requested_by_user_id") @db.Uuid
  requestedBy       User   @relation("PaymentRefundRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  status RefundStatus @default(PENDING)

  /// `re_…` — la référence du prestataire, une fois l'ordre accepté.
  ///
  /// Nulle tant que la demande est `PENDING` ou `FAILED` : elle n'existe pas
  /// avant que le prestataire ne l'ait rendue. Unique par établissement, ce qui
  /// interdit d'inscrire deux fois le même remboursement.
  providerRefundId String? @map("provider_refund_id") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, providerRefundId])
  // L'axe de lecture unique de cette table : « qu'a-t-on déjà rendu sur cet
  // encaissement ? », du plus ancien au plus récent. C'est la somme que le
  // service compare au montant capturé avant d'ordonner quoi que ce soit.
  @@index([tenantId, paymentId, createdAt])
  @@map("payment_refunds")
}

/// Article revendu au comptoir — CDC §1.4, « POS de base : services et produits
/// retail » (#60).
///
/// ## Pourquoi une table, et pas un libellé libre sur la ligne de ticket
///
/// Parce que le prix doit avoir une source côté serveur. Un produit saisi au
/// comptoir sous forme de « nom + montant » ferait du front l'autorité sur le
/// montant encaissé, ce que le troisième critère de #60 interdit en toutes
/// lettres. Le comptoir désigne un article ; c'est cette ligne-ci qui dit ce
/// qu'il coûte.
///
/// ## Pourquoi elle vit dans `payments` et non dans `catalog`
///
/// api-module §1 range explicitement les « ventes retail » dans `payments`, et
/// `catalog` dans « services, catégories, durée, prix, affectation aux
/// praticiens ». Un produit n'a ni durée, ni praticien, ni créneau : il
/// n'entrerait dans aucune des lectures que `catalog` sert, et le moteur de
/// disponibilité n'a rien à en faire.
model Product {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Référence interne du salon — le code qu'on lit sur l'étiquette.
  ///
  /// Unique **par établissement** et non globalement : deux salons ont le droit
  /// de coder chacun son shampoing `SH-01`, exactement comme ils ont chacun leur
  /// « Massage 60 min » (tenant-isolation §1).
  sku String @db.VarChar(64)

  name String @db.VarChar(160)

  /// Prix de vente affiché : entier dans la plus petite unité, code devise
  /// explicite. Même forme que `services.price_amount_minor`, et pour la même
  /// raison — les deux se retrouvent côte à côte sur un ticket, et deux
  /// représentations de l'argent sur une même addition finissent par diverger.
  priceAmountMinor Int    @map("price_amount_minor")
  priceCurrency    String @map("price_currency") @db.Char(3)

  /// Sortie du rayon — jamais une suppression : les tickets passés référencent
  /// l'article, et le reporting doit continuer à savoir ce qui a été vendu.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  saleItems SaleItem[]

  @@unique([tenantId, sku])
  // Cible des clés étrangères composites — voir `User.@@unique([tenantId, id])`.
  @@unique([tenantId, id])
  // La seule lecture de liste prévue : le rayon vendable, trié pour l'écran de
  // saisie. `is_active` en deuxième position parce que le filtre précède le tri.
  @@index([tenantId, isActive, name])
  @@map("products")
}

/// Ticket de caisse — l'addition composée au comptoir (#60).
///
/// ## Les quatre montants, et pourquoi ils sont stockés
///
/// `subtotal`, `tax`, `tip` et `total` sont **dérivés** des lignes : ils
/// pourraient se recalculer à chaque lecture. Ils sont écrits quand même, parce
/// qu'un ticket est une pièce comptable — ce qui a été présenté à la cliente ne
/// doit pas changer parce qu'un taux de taxe a été modifié depuis, ni parce
/// qu'un article a changé de prix. Les recalculer à la lecture ferait varier
/// l'histoire.
///
/// La cohérence entre les quatre est portée en base par
/// `sales_total_amount_minor_check` : `total = subtotal + tax + tip`,
/// vérifié par PostgreSQL et pas seulement par le service qui les compose.
///
/// ## Les prix du catalogue sont **TTC** (#816)
///
/// Le sens de deux de ces montants a changé sans que leur colonne ne bouge, et
/// c'est ce qui rend ces commentaires nécessaires. Jusqu'à #816, la taxe était
/// **ajoutée** à un sous-total tenu pour hors taxes ; elle est désormais
/// **extraite** des prix affichés, qui s'entendent toutes taxes comprises
/// (arrêté du 3 décembre 1987 sur l'information du consommateur sur les prix).
/// `subtotal + tax` refait donc exactement la somme des prix du catalogue, et
/// `sales_total_amount_minor_check` tient telle quelle — d'où l'absence de
/// migration. La table de référence est dans
/// `apps/api/src/modules/payments/README.md`, et `pos.totals.ts` la répète au
/// plus près du calcul.
///
/// Conséquence à connaître avant d'écrire une lecture : **additionner les
/// `sale_items.line_amount_minor` d'un ticket ne donne pas son total**. La ligne
/// `TAX` est une ventilation des lignes de catalogue, pas un supplément — la
/// sommer compte la taxe deux fois. Le total est `total_amount_minor`.
///
/// ## Une devise, une seule
///
/// `currency` est celle de l'établissement au moment de la vente, et toutes les
/// lignes la portent à l'identique. Le service refuse la vente d'un article
/// libellé dans une autre devise plutôt que de convertir : une conversion sans
/// taux daté n'est pas une conversion, c'est une approximation dans une pièce
/// comptable.
model Sale {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Le rendez-vous honoré que ce ticket facture, ou `null` pour une vente
  /// autonome — le deuxième critère de #60, « une vente peut être liée à un
  /// rendez-vous ou autonome ».
  ///
  /// Nullable dès le départ, et non ajouté après coup : la vente retail au
  /// comptoir n'est pas un cas dégradé de la prestation, c'est la moitié du POS.
  appointmentId String?      @map("appointment_id") @db.Uuid
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  /// Le compte qui a composé le ticket — la traçabilité que payments-stripe §4
  /// exige de l'encaissement au comptoir.
  ///
  /// `NOT NULL` : un ticket sans opérateur ne se rapproche de rien. Il vient du
  /// jeton vérifié, jamais du corps de la requête (tenant-isolation §2).
  cashierUserId String @map("cashier_user_id") @db.Uuid
  cashier       User   @relation("SaleCashier", fields: [cashierUserId], references: [id], onDelete: Restrict)

  /// La part **hors taxe** des lignes `SERVICE` et `PRODUCT` — et non leur
  /// somme, qui est un montant TTC depuis #816. Égale cette somme quand
  /// l'établissement n'a pas de taux.
  subtotalAmountMinor Int @map("subtotal_amount_minor")

  /// La taxe **comprise dans** les prix de ces mêmes lignes — une ventilation,
  /// pas un montant ajouté. C'est ce que porte la ligne `TAX` du ticket, quand
  /// il y en a une. `0` quand l'établissement n'a pas de taux.
  taxAmountMinor Int @map("tax_amount_minor")

  /// Le taux **sous lequel ce ticket a été composé**, en points de base — #818,
  /// cinquième critère, « ventilation de la TVA par taux ».
  ///
  /// Figé sur la vente, comme `sale_items.label` fige le nom de l'article : un
  /// salon qui passe de 20 % à 10 % ne doit pas réécrire la ventilation de ses
  /// tickets passés. Relire `tenants.tax_rate_bps` à l'affichage aurait fait
  /// exactement cela.
  ///
  /// Et non déduit des montants : `subtotal` étant arrondi à l'unité, le taux
  /// qu'on en retire ne revient pas toujours à celui qui l'a produit — un ticket
  /// de 65,00 € à 20 % donne 54,17 € hors taxe et 10,83 € de taxe, dont la
  /// division rend 19,99 %. Une pièce comptable ne peut pas annoncer un taux
  /// faux d'un point de base.
  taxRateBps Int @default(0) @map("tax_rate_bps")

  /// Somme des lignes `TIP` — le pourboire, hors taxe par nature : il n'entre
  /// dans aucune extraction. `0` quand la cliente n'a rien laissé.
  tipAmountMinor Int @map("tip_amount_minor")

  /// Ce que la cliente doit : la **somme des prix affichés**, plus le
  /// pourboire. Écrit sous la forme `subtotal + tax + tip`, celle que
  /// `sales_total_amount_minor_check` vérifie en base.
  totalAmountMinor Int @map("total_amount_minor")

  currency String @db.Char(3)

  /// Ce qui a déjà été **engagé** sur ce ticket, en plus petite unité — #817.
  ///
  /// ## C'est ici que « zéro double encaissement » se tient
  ///
  /// `sales_settled_amount_minor_check` impose `0 ≤ settled ≤ total` : un
  /// règlement qui dépasserait le reste dû est **non représentable**, et ce
  /// n'est donc pas une vérification applicative qui le refuse. Le service
  /// ajoute le montant sous le verrou de la ligne (`SELECT … FOR UPDATE`) — la
  /// conduite qu'ADR 0002 impose au moteur de réservation : deux comptoirs qui
  /// règlent la même vente au même instant ne peuvent pas lire tous deux « rien
  /// d'encaissé » et conclure tous deux que le geste est possible.
  ///
  /// ## « Capturé » et non « engagé », et c'est décisif
  ///
  /// Une intention carte en ligne ne compte **pas** tant que Stripe n'a rien
  /// confirmé : c'est le webhook `payment_intent.succeeded` qui fait avancer ce
  /// compte, dans la transaction même où il écrit `SUCCEEDED`. Réserver dès
  /// l'ouverture de l'intention a été écarté — un refus de banque est un
  /// incident ordinaire, et il aurait condamné le ticket jusqu'à ce qu'un
  /// webhook relâche la somme.
  ///
  /// Ce que cela laisse ouvert — un ticket réglé au comptoir pendant qu'une
  /// intention est en vol — est fermé un cran plus haut : `SettlementRepository`
  /// refuse un règlement de comptoir sur un ticket qui porte une intention
  /// carte `PENDING`.
  settledAmountMinor Int @default(0) @map("settled_amount_minor")

  /// L'instant où le ticket a été **soldé** — nul tant qu'il reste un centime
  /// dû, et c'est ce que `sales_settled_at_check` vérifie.
  ///
  /// Une colonne plutôt qu'une comparaison recalculée à la lecture : c'est elle
  /// que le refus 409 `SALE_ALREADY_SETTLED` du troisième critère relit, et une
  /// pièce comptable doit porter la date à laquelle elle a été soldée, pas la
  /// déduire de l'égalité de deux montants.
  settledAt DateTime? @map("settled_at") @db.Timestamptz(6)

  /// Le **rang de la pièce** dans la suite de l'établissement — #818, premier
  /// critère.
  ///
  /// ## Nul tant que la vente n'est pas close, et c'est tout le dispositif
  ///
  /// Le numéro est attribué **à la clôture**, dans la transaction même qui pose
  /// `settled_at`, par {@link ReceiptCounter} verrouillé en `SELECT … FOR
  /// UPDATE`. Un ticket ouvert puis abandonné au comptoir ne consomme donc
  /// aucun rang, et c'est précisément ce que « la suite n'a aucun trou » exige :
  /// numéroter à l'ouverture aurait percé la suite au premier panier délaissé.
  ///
  /// La colonne est nullable pour la même raison — un ticket ouvert n'a pas de
  /// numéro —, et PostgreSQL tenant deux `NULL` pour distincts, autant de
  /// tickets ouverts qu'on veut cohabitent sous l'unique.
  ///
  /// ## Pourquoi un compteur verrouillé et non une séquence
  ///
  /// Une `SEQUENCE` PostgreSQL ne revient **pas** en arrière quand la
  /// transaction qui l'a consommée échoue : c'est sa propriété de conception, et
  /// c'est exactement le trou que le critère interdit. Une ligne de compteur
  /// verrouillée, elle, est incrémentée **dans** la transaction : un règlement
  /// annulé rend son rang, et le suivant le reprend.
  ///
  /// `MAX(receipt_number) + 1` a été écarté pour l'autre raison, symétrique :
  /// deux clôtures simultanées liraient le même maximum et écriraient le même
  /// rang — l'unique en refuserait une, et le comptoir recevrait une panne là
  /// où il doit recevoir un ticket.
  ///
  /// ## Un entier, et l'affichage se compose ailleurs
  ///
  /// `TIC-2026-000123` est une **forme**, pas une valeur : le préfixe vit sur
  /// l'établissement, l'année se lit sur la date de la pièce, et seul le rang
  /// est stocké. Le contrat partagé compose les trois (`formatReceiptNumber`),
  /// si bien qu'un salon qui change de préfixe ne réécrit pas ses tickets
  /// passés — il change ce que les prochains afficheront.
  receiptNumber Int? @map("receipt_number")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items    SaleItem[]
  payments Payment[]

  // Cible des clés étrangères composites — voir `User.@@unique([tenantId, id])`.
  @@unique([tenantId, id])
  // **La suite des pièces de caisse** (#818, premier critère) : unique par
  // établissement, jamais globalement — deux salons ne se citent pas l'un
  // l'autre, et une unicité globale aurait fait dépendre la numérotation d'un
  // salon du volume de tous les autres (tenant-isolation §1).
  //
  // L'index sert les deux usages d'un seul objet : il **garantit** l'unicité du
  // rang et il **sert** la recherche d'un ticket par son numéro au comptoir.
  @@unique([tenantId, receiptNumber])
  // L'historique des ventes, du plus récent au plus ancien (#62).
  @@index([tenantId, createdAt])
  // « Qu'a-t-on facturé sur ce rendez-vous ? » — la lecture de la fiche client
  // et du rapprochement. C'est aussi par lui que l'encaissement d'un rendez-vous
  // retrouve son ticket avant d'en composer un second (#817).
  @@index([tenantId, appointmentId])
  // « Qu'a-t-on soldé, et quand ? » — l'axe du rapprochement de caisse depuis
  // que le revenu se lit sur les ventes réglées (sixième critère de #817).
  @@index([tenantId, settledAt])
  @@map("sales")
}

/// Une ligne du ticket — le premier critère de #60, « un ticket regroupe
/// plusieurs lignes : services rendus et produits ».
///
/// ## Le libellé est figé, la référence est conservée
///
/// `label` recopie le nom de l'article **au moment de la vente**, et
/// `service_id` / `product_id` continuent de pointer la ligne de catalogue. Les
/// deux sont nécessaires et ne font pas double emploi : la référence sert au
/// reporting (« combien de shampoings vendus ce mois-ci »), le libellé sert au
/// ticket (« ce que la cliente a lu sur son reçu »). Un renommage d'article ne
/// doit pas réécrire les tickets passés.
///
/// ## Ce que la ligne ne porte pas
///
/// Aucun taux, aucune remise, aucun praticien bénéficiaire du pourboire : les
/// forfaits, les cartes cadeaux et le partage de pourboire entre praticiens sont
/// **hors périmètre MVP** (payments-stripe §8). Le modèle reste simple tant que
/// le besoin n'est pas remonté.
model SaleItem {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  saleId String @map("sale_id") @db.Uuid
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Restrict)

  kind SaleItemKind

  /// L'article vendu, selon `kind`. Les deux sont nuls sur une ligne `TAX` ou
  /// `TIP`, qui ne référencent rien — et `sale_items_reference_check` impose
  /// qu'une ligne porte exactement la référence de sa nature, ni plus ni moins.
  serviceId String?  @map("service_id") @db.Uuid
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  productId String?  @map("product_id") @db.Uuid
  product   Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  /// Ce que la cliente lit sur son reçu, figé à la vente.
  label String @db.VarChar(160)

  /// Toujours `1` sur une ligne `TAX` ou `TIP` : elles n'ont pas de quantité, et
  /// un `0` ferait une ligne à zéro que rien ne distinguerait d'une erreur.
  quantity Int

  /// Prix unitaire retenu, et `unit × quantity`. Les deux sont écrits parce que
  /// le reçu montre le premier et que la somme porte sur le second ; leur
  /// cohérence est vérifiée en base par `sale_items_line_amount_minor_check`.
  unitAmountMinor Int    @map("unit_amount_minor")
  lineAmountMinor Int    @map("line_amount_minor")
  currency        String @db.Char(3)

  /// Rang de la ligne sur le ticket, à partir de `0` — l'ordre dans lequel le
  /// comptoir l'a composée. Sans lui, deux lignes créées dans la même
  /// milliseconde se réordonneraient d'une lecture à l'autre.
  position Int

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Un rang par ticket — c'est ce qui rend l'ordre du reçu stable.
  @@unique([tenantId, saleId, position])
  @@map("sale_items")
}

/// Le compteur de pièces d'un établissement — #818, premier critère.
///
/// **Une ligne par salon**, et c'est la clé primaire qui le dit : `@@id([tenantId])`.
/// Un compteur en double serait deux suites concurrentes sur la même colonne
/// `sales.receipt_number`, c'est-à-dire un trou garanti dès la deuxième
/// clôture ; la base l'interdit plutôt que le code ne le surveille.
///
/// ## Ce que `next_value` signifie exactement
///
/// **Le prochain rang à attribuer**, jamais le dernier attribué. Un salon qui
/// n'a rien vendu porte `1`, et la première clôture prend `1` puis écrit `2`.
/// L'autre convention aurait obligé chaque lecteur à savoir s'il faut ajouter un
/// — et le premier qui l'oublie écrit deux fois le même rang.
///
/// ## Le verrou, et pourquoi il est dans la transaction de clôture
///
/// `SELECT "next_value" … FOR UPDATE` sérialise les clôtures concurrentes d'un
/// même établissement : le second entrant **attend** que le premier ait
/// commité, relit la valeur qu'il vient d'écrire, et prend le rang suivant.
/// C'est la conduite qu'ADR 0002 impose au moteur de réservation, appliquée ici
/// au seul invariant équivalent de la caisse — « la suite n'a aucun trou, même
/// sous concurrence ».
///
/// Et parce que l'incrément vit **dans** la transaction de clôture, il revient
/// en arrière avec elle : un règlement qui échoue au `CHECK` de
/// `sales_settled_amount_minor_check` ne consomme aucun rang. C'est ce qu'une
/// `SEQUENCE` PostgreSQL ne sait pas faire, et c'est la raison pour laquelle
/// cette table existe au lieu d'un `nextval()`.
///
/// ## Ni année, ni série
///
/// La suite est **continue par établissement**, et l'année du format
/// `{PRÉFIXE}-{AAAA}-{000123}` n'en est que la lecture : un compteur remis à
/// zéro chaque année produirait deux ventes de même rang dans deux exercices,
/// que `sales_tenant_id_receipt_number_key` refuse d'écrire.
///
/// ## Le `id` de cette table ne sert d'accès à personne
///
/// Toute table de ce schéma porte un `id` en UUID — c'est l'invariant que
/// `prisma-schema.spec.ts` relit, et il existe pour qu'aucun identifiant
/// séquentiel ne soit exposé. Un compteur n'a pas d'identité publique : il
/// s'adresse par son établissement, qui est aussi sa clé primaire. La colonne
/// est donc là, et rien ne la lit.
model ReceiptCounter {
  id       String @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Le prochain rang à attribuer — jamais le dernier attribué.
  nextValue Int @default(1) @map("next_value")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId])
  @@map("receipt_counters")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

/// Message émis (confirmation, rappel J-1, avis d'annulation).
///
/// `dedupe_key` porte l'idempotence des envois : le planificateur peut rejouer
/// un rappel, la contrainte d'unicité garantit qu'un client ne reçoit pas deux
/// fois le même SMS. Aucune coordonnée n'est recopiée ici — l'adresse de
/// destination se relit sur le compte au moment de l'envoi, pour ne pas
/// dupliquer de donnée personnelle (CDC §5.1).
///
/// ## Deux uniques, et ils ne disent pas la même chose (#68)
///
/// `@@unique([tenantId, dedupeKey])` est l'identité du **message** : « cette
/// livraison-là, une fois ». Elle couvre tous les statuts, `FAILED` compris.
///
/// L'autre est un **index unique partiel**, que Prisma n'exprime pas et qui vit
/// donc en SQL brut. Posé par `20260906120000_add_notification_idempotency`,
/// **remplacé** par `20260908120000_notification_live_once_per_recipient`
/// (api-module §6) :
///
/// ```sql
/// CREATE UNIQUE INDEX "notifications_live_once"
///   ON "notifications" (
///     "tenant_id", "appointment_id", "type", "channel",
///     COALESCE("recipient_user_id", '00000000-0000-0000-0000-000000000000'::uuid)
///   )
///   WHERE "status" IN ('PENDING', 'SENT');
/// ```
///
/// Elle est l'invariant sur la **donnée** : au plus un message vivant par
/// établissement, rendez-vous, type, canal et destinataire — quelle qu'ait été
/// la clé de déduplication qui l'a produit. C'est elle que notifications §2
/// nomme, et c'est elle qui tient quand deux producteurs composent leur
/// `dedupe_key` différemment : le balayage horaire du rappel J-1 et l'événement
/// de domaine ne se coordonnent pas, et rien ne les y oblige puisque la base
/// tranche.
///
/// Le destinataire est entré dans la clé avec #534, et il est en **queue** :
/// `tenant_id` reste en tête (tenant-isolation §1). Sans lui, l'avis
/// d'annulation ne pouvait pas prévenir la cliente **et** le praticien de la
/// même annulation — le second envoi était refusé, et le CDC §1.4 demande les
/// deux. Le `COALESCE` est ce qui empêche que l'ajout d'une colonne nullable
/// affaiblisse l'invariant : PostgreSQL tient deux `NULL` pour distincts, et
/// deux messages vivants sans destinataire seraient sinon passés côte à côte.
///
/// Le `WHERE` est le cœur du dispositif : un envoi `FAILED` **libère** la place,
/// exactement comme un rendez-vous annulé libère son créneau dans
/// `appointments_no_overlap`. Sans lui, un échec transitoire — un throttling SES
/// — condamnerait définitivement le rappel, et SQS rejouerait dans le vide.
///
/// Ce que l'index ne couvre pas, et qui est voulu : `appointment_id` étant
/// nullable, PostgreSQL tient deux `NULL` pour distincts. Un message sans
/// rendez-vous n'est donc dédupliqué que par `dedupe_key`. Les trois types du
/// périmètre MVP (CDC §1.4) portent tous un rendez-vous ; le jour où un message
/// hors rendez-vous apparaîtra, il faudra le dire ici.
model Notification {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  appointmentId String?      @map("appointment_id") @db.Uuid
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  recipientUserId String? @map("recipient_user_id") @db.Uuid
  recipient       User?   @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)

  type    NotificationType
  channel NotificationChannel
  status  NotificationStatus  @default(PENDING)

  /// Clé d'idempotence : « ce message-là, pour ce rendez-vous-là, une fois ».
  dedupeKey String @map("dedupe_key") @db.VarChar(255)

  /// Instant d'envoi voulu — le rappel J-1 est planifié, pas immédiat.
  scheduledFor DateTime? @map("scheduled_for") @db.Timestamptz(6)
  sentAt       DateTime? @map("sent_at") @db.Timestamptz(6)

  /// L'accusé du fournisseur — `MessageId` de SES ou de SNS (#68).
  ///
  /// Renseigné en même temps que le passage à `SENT`, et par lui seul : il est
  /// la preuve que l'appel a abouti, pas qu'il a été tenté. C'est la seule
  /// référence qui permette de retrouver une livraison chez AWS depuis un
  /// incident client, et notifications §7 en fait le **seul** identifiant que le
  /// journal ait le droit de porter — ni destinataire, ni contenu.
  ///
  /// Opaque et non personnel, comme `provider_payment_intent_id` l'est pour
  /// `payments`.
  providerMessageId String? @map("provider_message_id") @db.VarChar(255)

  attemptCount  Int     @default(0) @map("attempt_count")
  failureReason String? @map("failure_reason") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, scheduledFor])
  @@index([tenantId, appointmentId])
  @@map("notifications")
}

/// La **personnalisation** des messages d'un établissement — #69,
/// notifications §6, « un salon doit pouvoir personnaliser ses messages sans
/// déploiement ».
///
/// ## Ce que la table contient, et ce qu'elle ne contient pas
///
/// Uniquement ce qu'un salon a délibérément écrit. Les modèles **par défaut de
/// la plateforme** restent en code (`notification-default-templates.ts`) : ils
/// n'ont, par définition, pas d'établissement, et les inscrire ici aurait exigé
/// un `tenant_id` nullable — c'est-à-dire une ligne que l'extension de scoping ne
/// sait pas borner, dans la table même qui décide de ce que les clientes de
/// chaque salon reçoivent (tenant-isolation §1). L'autre issue aurait été de
/// recopier les quatre modèles dans chaque établissement à sa création, ce qui
/// aurait fait d'une correction de coquille une migration de données sur tous les
/// tenants.
///
/// Une ligne absente n'est donc pas un manque : c'est un salon qui n'a rien
/// personnalisé, et qui reçoit le défaut. Supprimer la ligne **est** le retour au
/// défaut, sans qu'aucun contenu n'ait à être recopié.
///
/// ## Ni destinataire, ni contenu rendu
///
/// Un modèle n'est pas un message : il porte des balises `{{client}}`, jamais un
/// nom de cliente. La règle du module — « aucune donnée personnelle qui persiste »
/// (CDC §5.1, notifications §7) — est ici tenue par construction, et c'est la
/// raison pour laquelle cette table peut être lue au back-office sans réserve.
model NotificationTemplate {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  type    NotificationType
  channel NotificationChannel

  /// Objet de l'e-mail. Chaîne **vide** sur le canal SMS, qui n'en a pas.
  ///
  /// Vide plutôt que nullable : la distinction entre « pas d'objet » et « objet
  /// absent » n'existe pas pour un SMS, et une colonne nullable aurait obligé
  /// chaque lecture à s'en défendre pour un cas qui ne se produit jamais.
  subject String @db.VarChar(200)

  /// Corps HTML. Vide sur le canal SMS.
  ///
  /// `TEXT` et non `VARCHAR(n)` : un e-mail HTML de mise en page raisonnable
  /// dépasse volontiers deux mille caractères, et PostgreSQL stocke les deux
  /// types exactement de la même façon — une borne arbitraire n'aurait fait que
  /// refuser un jour un modèle légitime. La borne qui compte est applicative et
  /// elle est ailleurs : elle porte sur le coût du SMS, pas sur la taille du HTML.
  bodyHtml String @map("body_html")

  /// Version texte brut — doublon de l'e-mail, corps du SMS. **Jamais vide.**
  ///
  /// Quatrième critère d'acceptation de #69 : « version texte brut
  /// systématiquement fournie à côté du HTML ». Un e-mail qui n'a que du HTML est
  /// pénalisé par les filtres anti-spam (notifications §6), et le rappel J-1 perd
  /// tout intérêt s'il finit en indésirables. L'invariant est tenu par la
  /// validation du DTO, qui refuse un texte vide sur les deux canaux.
  bodyText String @map("body_text")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Un message, un canal, un modèle — et l'unicité est composite avec le
  /// tenant, comme tout unique métier : deux salons personnalisent chacun leur
  /// confirmation par e-mail.
  ///
  /// C'est aussi l'index de lecture : la résolution du modèle effectif interroge
  /// exactement `(tenant_id, type, channel)` avant chaque envoi, et l'unique la
  /// sert sans qu'un second index soit nécessaire.
  @@unique([tenantId, type, channel])
  @@map("notification_templates")
}

/// Un événement de webhook Stripe déjà traité — la table qui rend le traitement
/// **idempotent** (payments-stripe §3).
///
/// Stripe rejoue ses événements : à chaque réponse non-2xx, à chaque délai
/// dépassé, et parfois sans raison visible. Sans elle, un rejeu de
/// `charge.refunded` rembourserait deux fois dans notre comptabilité, et un
/// rejeu de `payment_intent.succeeded` réémettrait la confirmation d'un
/// rendez-vous déjà confirmé.
///
/// ## L'insertion *est* le verrou
///
/// La ligne s'insère **dans la même transaction** que l'effet métier. Deux
/// livraisons concurrentes du même événement — Stripe n'en exclut aucune — se
/// sérialisent sur l'unique : la première valide, la seconde échoue en `P2002`
/// et son `ROLLBACK` annule l'effet qu'elle avait commencé à écrire. Ce n'est
/// donc pas un « ai-je déjà vu cet événement ? » suivi d'une écriture, conduite
/// que deux requêtes simultanées rendraient vaine — la même que celle que
/// booking-engine §1 interdit au moteur de réservation, pour la même raison.
///
/// ## Pourquoi elle porte `tenant_id`
///
/// payments-stripe §3 la décrit `processed_webhook_events(event_id PRIMARY KEY,
/// processed_at)`, sans tenant. Elle en porte un ici, et ce n'est pas un excès
/// de zèle : tenant-isolation §1 n'exempte que `tenants`, les tables de
/// référence globales et les tables techniques, et toute autre exception se
/// documente en ADR. Une table sans `tenant_id` serait de toute façon refusée
/// par l'extension de scoping (`UnscopedModelNotAllowedError`) tant qu'elle
/// n'est pas inscrite dans `GLOBAL_MODELS` — c'est-à-dire rendue lisible par
/// tous les établissements à la fois.
///
/// L'unique est donc `(tenant_id, event_id)` et non `event_id` seul. La
/// garantie ne s'en trouve pas affaiblie : le tenant est résolu depuis les
/// métadonnées de l'intention, écrites par nous à la création et authentifiées
/// par la signature du corps, si bien qu'un même `evt_…` retombe toujours sur
/// le même établissement. Un événement dont le tenant ne se résout pas n'est
/// jamais traité, et n'a donc aucun effet à rendre idempotent.
///
/// ## Ce qu'elle ne contient pas
///
/// Pas de corps d'événement, pas de charge utile Stripe, pas de dernier quatuor
/// de chiffres : rien qui ressemble à une donnée de carte n'y entre, et un
/// corps d'événement complet en base serait très exactement le journal que
/// payments-stripe §1 interdit. `event_type` suffit à la réconciliation du CDC
/// §4.9 — le reste se relit chez Stripe, qui en est la source de vérité.
///
/// Pas de `processed_at` non plus, et c'est la même économie : la ligne
/// n'existe que si la transaction de traitement a validé, donc `created_at`
/// **est** l'instant de traitement.
model ProcessedWebhookEvent {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// L'identifiant Stripe de l'événement — `evt_…`. Opaque, non personnel.
  eventId String @map("event_id") @db.VarChar(255)

  /// `payment_intent.succeeded`, `charge.refunded`… Conservé pour la
  /// réconciliation : sans lui, la table dirait « déjà vu » sans dire de quoi.
  eventType String @map("event_type") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // La contrainte qui porte toute l'idempotence de la chaîne de webhooks.
  @@unique([tenantId, eventId])
  // Purge par ancienneté et audit de réconciliation — les deux seules lectures
  // prévues, et toutes deux bornées à un établissement.
  @@index([tenantId, createdAt])
  @@map("processed_webhook_events")
}

/// La file durable des livraisons de webhook Stripe — #409.
///
/// ## Ce qu'elle rend vrai, et que rien d'autre ne rendait vrai
///
/// Le contrôleur répond 200 **avant** de traiter (payments-stripe §3), et
/// Stripe ne redélivre que ce qu'il a vu échouer. À partir de cet accusé, la
/// livraison n'existe plus que chez nous : un processus qui meurt, ou un
/// traitement qui échoue en base, laissait jusqu'ici l'encaissement `PENDING`
/// et le rendez-vous jamais confirmé — sans que personne ne le sache, sauf à
/// lire le journal.
///
/// Cette table est ce qui déplace la livraison de la mémoire d'un processus
/// vers le disque d'une base, **avant** l'accusé. La ligne est inscrite pendant
/// la requête HTTP ; si elle ne peut pas l'être, la route ne rend pas 2xx et
/// c'est Stripe qui redélivre. Après l'accusé, la ligne est le seul
/// propriétaire de la livraison, et elle survit à ce à quoi un processus ne
/// survit pas.
///
/// ## Elle ne double pas `processed_webhook_events`
///
/// Les deux tables ne parlent pas du même objet, et aucune ne remplace l'autre :
///
/// | Table | Ce qu'elle porte | Durée de vie |
/// |---|---|---|
/// | `stripe_webhook_deliveries` | le **travail à faire** | de l'accusé au traitement — puis supprimée |
/// | `processed_webhook_events` | la **preuve que c'est fait** | conservée, c'est l'idempotence |
///
/// Une livraison aboutie est donc supprimée d'ici : ce qui reste est ce qui
/// attend, ce qui réessaie, et ce qui est mort. Une table de file qui
/// conserverait ses succès grossirait indéfiniment pour redire ce que la
/// seconde dit déjà.
///
/// ## Aucune donnée de carte, aucune donnée personnelle
///
/// `payload` est l'événement **réduit** que `readWebhookEvent` produit — des
/// identifiants opaques (`evt_…`, `pi_…`, `ch_…`), un montant en centimes, un
/// type. Jamais le corps Stripe brut, que payments-stripe §1 interdit de
/// conserver, et rien qui désigne une personne (CDC §5.1).
model StripeWebhookDelivery {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// L'identifiant Stripe de l'événement — `evt_…`, la clé de dédoublonnage.
  eventId String @map("event_id") @db.VarChar(255)

  /// `payment_intent.succeeded`, `charge.refunded`… — lisible sans désérialiser
  /// `payload`, ce qui rend une file en souffrance diagnosticable d'un `SELECT`.
  eventType String @map("event_type") @db.VarChar(255)

  /// La clé de **sérialisation** — l'encaissement concerné, `pi_…` ou `ch_…`.
  ///
  /// C'est le second constat de #409, tranché : deux livraisons portant sur le
  /// même encaissement ne s'appliquent pas en parallèle. Aujourd'hui la file
  /// applicative chaîne sur cette clé ; le jour du passage à SQS, elle devient
  /// le `MessageGroupId` d'une file FIFO, sans qu'une ligne de schéma bouge.
  /// La persister plutôt que de la recalculer est ce qui rend cette continuité
  /// possible — une livraison reprise après un redémarrage retrouve la chaîne
  /// qu'elle avait quittée.
  serializationKey String @map("serialization_key") @db.VarChar(255)

  /// L'événement réduit, tel que `readWebhookEvent` l'a produit — jamais le
  /// corps brut de Stripe.
  payload Json

  status WebhookDeliveryStatus @default(PENDING)

  /// Nombre de tentatives déjà consommées — ce que borne `RetrySchedule`.
  attempts Int @default(0)

  /// L'instant à partir duquel la livraison est de nouveau tentable.
  ///
  /// **Toujours daté depuis l'horloge du processus, jamais par le défaut du
  /// moteur.** Trois chemins écrivent cette colonne, et chacun pose son propre
  /// `Date` :
  ///
  /// | Écrivain | L'instant qu'il pose |
  /// |---|---|
  /// | `StripeWebhookRepository.spool` | l'inscription — échue tout de suite, la file traite sans attendre |
  /// | `StripeWebhookRepository.reviveDeadDelivery` | la résurrection d'une ligne `DEAD`, redélivrée par Stripe |
  /// | `DurableWebhookQueue.postpone` → `rescheduleDelivery` | le réessai, gigue de `retryDelayMs` comprise |
  ///
  /// Le `@default(now())` reste déclaré — il couvre une écriture qui viendrait
  /// d'ailleurs —, mais le seul de ces chemins qui insère, `spool`, ne le laisse
  /// plus décider ; les deux autres sont des mises à jour, qu'aucun défaut ne
  /// couvre.
  ///
  /// La règle n'est pas une préférence de style, c'est le prédicat du balayage :
  /// `claimAbandonedDeliveries` ne retient que les lignes vérifiant
  /// `next_attempt_at <= claim.now`, où ce `now` est le `new Date()` que
  /// `sweepOnce` lui passe. Laisser le moteur dater l'écriture mettrait deux
  /// horloges de part et d'autre de la même comparaison, et une livraison
  /// inscrite avec une horloge serveur de quelques millisecondes en avance
  /// serait jugée « pas encore échue » par tout balayage dont le `now` précède
  /// cette échéance. Sans portée en exploitation — le tour suivant arrive un
  /// quart de minute plus tard et la reprend —, mais décisif pour une suite
  /// d'intégration qui ne balaie qu'une fois : c'est là que le défaut de #555 se
  /// voyait.
  ///
  /// Le garde-fou vaut donc chemin par chemin. Retirer le `nextAttemptAt: now`
  /// de `spool` comme « redondant avec le défaut » restaurerait ce défaut en
  /// silence. Le retirer d'un des deux `updateMany` ferait tout autre chose — un
  /// défaut ne s'applique qu'à l'insertion : la colonne garderait l'échéance
  /// précédente au lieu de la nouvelle.
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(6)

  /// Le bail : une instance tient cette livraison, et depuis quand.
  ///
  /// `NULL` veut dire « personne ». Une valeur plus vieille que le bail veut
  /// dire « l'instance qui la tenait ne répond plus » — c'est exactement l'état
  /// que laisse un `SIGKILL`, et c'est ce qui rend la reprise automatique
  /// possible sans qu'aucune instance n'ait à savoir qu'une autre est morte.
  claimedAt DateTime? @map("claimed_at") @db.Timestamptz(6)

  /// La dernière panne, tronquée — de quoi diagnostiquer une ligne `DEAD` sans
  /// remonter le journal. Jamais une pile d'appels : le nom et le message.
  lastError String? @map("last_error") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Deux livraisons du même événement ne font qu'une ligne. Stripe redélivre
  /// tant qu'il n'a pas vu de 2xx : sans cet unique, une redélivrance arrivée
  /// pendant que la première attend son réessai créerait un second travail pour
  /// le même effet.
  @@unique([tenantId, eventId])
  /// L'index du balayage, préfixé par `tenant_id` comme tous les autres. Le
  /// balayage, lui, lit sans portée de tenant par nécessité — une livraison
  /// orpheline n'appartient à aucune requête —, mais la table ne contient que
  /// ce qui attend, les succès étant supprimés. Un parcours y porte sur
  /// quelques lignes, et un index sans `tenant_id` en tête aurait ouvert une
  /// voie de lecture inter-établissement pour n'économiser rien.
  @@index([tenantId, status, nextAttemptAt])
  @@map("stripe_webhook_deliveries")
}
