// Modèle de données du CDC §2.4 — les sept entités du MVP.
//
// Trois règles tiennent tout ce fichier, et aucune n'est négociable :
//
// 1. **`tenant_id` non nullable sur toute table métier**, avec clé étrangère
//    vers `tenants`. Seule `tenants` en est exemptée — c'est la racine, pas une
//    donnée d'établissement (.claude/skills/tenant-isolation/SKILL.md §1).
//    Tout index métier commence par `tenant_id`, et tout unique métier est
//    composite avec lui : deux salons ont le droit d'avoir chacun un service
//    « Massage 60 min » et une cliente « alice@example.test ».
// 2. **Aucun montant en flottant.** Un montant est un entier dans la plus petite
//    unité monétaire (`*_amount_minor`) accompagné de son code devise ISO 4217.
//    Un prix n'a pas de sens sans sa devise : les deux voyagent ensemble.
// 3. **Tout instant est un `timestamptz`**, stocké en UTC, converti à
//    l'affichage selon `tenants.timezone`. Un rendez-vous mal fuseau-horairé est
//    un bug de sévérité haute.
//
// Les identifiants sont des UUID v4 générés côté application : l'énumération
// d'identifiants séquentiels est un vecteur de fuite inter-tenant à part entière
// (tenant-isolation §4).
//
// Les suppressions sont volontairement `Restrict` : rien dans le périmètre MVP
// ne supprime un tenant, un client ou un rendez-vous — une annulation est un
// *statut*, pas un `DELETE`. L'effacement RGPD est une procédure dédiée et
// étagée, pas un effet de bord de cascade. Une seule exception, assumée :
// `ServiceStaff` est en `Cascade`, parce qu'une ligne d'affectation n'est pas une
// donnée en propre — elle ne survit ni à la prestation ni au praticien qu'elle
// relie.
//
// Deux garanties ne sont pas exprimables ici et vivent en SQL brut à la fin de la
// migration (api-module §6) :
//
// - les **clés étrangères composites `(tenant_id, id)`**, sans lesquelles une
//   ligne d'un salon pourrait référencer celle d'un autre — `tenant_id` sur la
//   table est nécessaire, il n'est pas suffisant ;
// - les **contraintes `CHECK`** qui bornent montants, durées et intervalles.
//
// Toute migration générée ensuite qui prétendrait les retirer est à corriger à la
// main avant d'être versée.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Énumérations
// ---------------------------------------------------------------------------

/// Rôle du compte — CDC §2.4 « Compte (client / staff / admin) + rôle », étendu
/// par le CDC §1.4 (« comptes staff avec rôles et permissions ») au rang
/// intermédiaire `MANAGER`.
///
/// **L'ordre des quatre libellés est signifiant.** PostgreSQL ordonne un `enum`
/// par son ordre de **déclaration**, et c'est cet ordre que rend le
/// `orderBy: { role: 'asc' }` de `listStaffAccounts`. Il est ici celui de la
/// hiérarchie d'autorisation — `CLIENT` < `STAFF` < `MANAGER` < `ADMIN` — et
/// `MANAGER` a donc été inséré *avant* `ADMIN` par la migration
/// `20260826100000_add_manager_user_role`, non ajouté en queue. Les deux ordres
/// sont verrouillés ensemble par `src/modules/identity/__tests__/roles.spec.ts`.
enum UserRole {
  CLIENT
  STAFF
  MANAGER
  ADMIN
}

/// Cycle de vie du rendez-vous. `CANCELLED` et `NO_SHOW` sont des statuts, pas
/// des suppressions : le reporting de base du MVP compte les no-shows.
enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// Moyen d'encaissement au comptoir — CDC §1.4 « carte/espèces ».
enum PaymentMethod {
  CARD
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum NotificationChannel {
  EMAIL
  SMS
}

/// Les trois messages du périmètre MVP — CDC §1.4 « Notifications ».
enum NotificationType {
  BOOKING_CONFIRMATION
  REMINDER_24H
  CANCELLATION
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ---------------------------------------------------------------------------
// Tenant — la racine de l'isolation
// ---------------------------------------------------------------------------

/// Établissement (salon, spa, barbershop).
///
/// Seule table sans `tenant_id` : elle *est* le tenant. Son `slug` est donc le
/// seul unique global du schéma — c'est lui qui résout l'établissement depuis
/// le sous-domaine ou l'URL des pages de réservation publiques, avant toute
/// authentification.
model Tenant {
  id String @id @default(uuid()) @db.Uuid

  slug String @unique @db.VarChar(63)
  name String @db.VarChar(160)

  /// Fuseau IANA (« Europe/Paris »), **obligatoire** : sans lui, aucun instant
  /// UTC stocké ici ne peut être rendu à l'écran. Pas de valeur par défaut —
  /// un défaut silencieux décalerait tout un agenda d'une heure.
  timezone String @db.VarChar(64)

  /// Devise par défaut de l'établissement (ISO 4217). Chaque montant porte
  /// malgré tout la sienne : celle-ci peut changer, les montants déjà encaissés
  /// non.
  defaultCurrency String @map("default_currency") @db.Char(3)

  contactEmail String? @map("contact_email") @db.VarChar(320)
  contactPhone String? @map("contact_phone") @db.VarChar(32)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users             User[]
  services          Service[]
  serviceCategories ServiceCategory[]
  staff             Staff[]
  serviceStaff      ServiceStaff[]
  appointments      Appointment[]
  payments          Payment[]
  notifications     Notification[]
  refreshTokens     RefreshToken[]

  @@map("tenants")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// Compte client, praticien ou administrateur.
///
/// L'unicité de l'e-mail est **par tenant** : une même personne peut être
/// cliente de deux salons sans que l'un puisse deviner l'existence de l'autre.
model User {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// L'unicité porte sur les octets : `Alice@Example.test` et
  /// `alice@example.test` cohabiteraient dans le même salon, et la recherche à
  /// la connexion ne trouverait qu'une des deux lignes. La normalisation en
  /// minuscules **avant écriture** revient au module `identity` — c'est là que
  /// se décide la forme canonique d'une adresse, pas ici.
  email String   @db.VarChar(320)
  role  UserRole

  /// Empreinte du mot de passe — jamais le mot de passe. Nullable : un client
  /// peut exister sans compte, saisi au comptoir par le staff.
  passwordHash String? @map("password_hash") @db.VarChar(255)

  firstName String  @map("first_name") @db.VarChar(80)
  lastName  String  @map("last_name") @db.VarChar(80)
  phone     String? @db.VarChar(32)

  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Au plus une fiche praticien — garanti par `@@unique([tenantId, userId])`
  /// sur `Staff`. Prisma type la relation en liste parce que la cardinalité
  /// s'appuie sur un unique **composite** et non sur un unique mono-colonne :
  /// c'est le prix à payer pour qu'aucun index métier ne commence par autre
  /// chose que `tenant_id`.
  staffProfiles         Staff[]
  clientAppointments    Appointment[]  @relation("AppointmentClient")
  receivedNotifications Notification[] @relation("NotificationRecipient")
  refreshTokens         RefreshToken[]

  @@unique([tenantId, email])
  // Cible des clés étrangères composites `(tenant_id, id)` posées en SQL brut
  // dans la migration — c'est ce couple, et non `id` seul, qui rend impossible
  // de rattacher la ligne d'un salon à celle d'un autre. Il sert aussi de clé de
  // lecture tenant-sûre : un `findUnique` sur `{ tenantId, id }` renvoie `null`
  // pour l'id d'un autre établissement, ce qui donne le 404 attendu plutôt qu'un
  // 403 (tenant-isolation §4).
  @@unique([tenantId, id])
  @@index([tenantId, role])
  @@map("users")
}

/// Session de rafraîchissement — une ligne par ouverture de session, et c'est
/// elle qui rend la déconnexion **invalidante**.
///
/// Un refresh token purement JWT ne se révoque pas : signé, il reste valable
/// jusqu'à son expiration, et « se déconnecter » se réduirait alors à effacer un
/// cookie que l'attaquant qui l'a volé n'effacera pas. L'état vit donc en base,
/// et le jeton n'en est que le porteur.
///
/// Ce qui est stocké n'est **pas** le jeton mais l'empreinte SHA-256 de son
/// `jti`. Une fuite de cette table ne donne donc aucune session : le `jti` est un
/// aléa de 256 bits, non devinable depuis son empreinte, et le jeton lui-même
/// doit de toute façon être signé pour être accepté. SHA-256 nu suffit ici — là
/// où un mot de passe exige bcrypt, un secret aléatoire de 256 bits n'a pas
/// d'espace de recherche à ralentir.
///
/// `token_hash` change à **chaque** rafraîchissement (rotation). Présenter un
/// `jti` qui ne correspond plus à l'empreinte courante signifie qu'un jeton déjà
/// consommé ressort : soit le vol, soit le rejeu. La session entière est alors
/// révoquée — c'est la détection de réemploi, et c'est ce qui limite la valeur
/// d'un refresh token dérobé à un seul usage.
model RefreshToken {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// Empreinte SHA-256 hexadécimale du `jti` courant — 64 caractères.
  tokenHash String @map("token_hash") @db.VarChar(64)

  /// Fin de vie de la session, indépendante de l'`exp` du jeton : c'est la base
  /// qui tranche, pas le porteur.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  /// Déconnexion, ou révocation sur détection de réemploi. Renseigné une fois,
  /// jamais remis à nul — une session révoquée ne se rouvre pas.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // L'empreinte est unique **par tenant**, comme tout unique métier. Elle n'est
  // pas la clé de lecture — le rafraîchissement retrouve la session par son `sid`
  // — mais elle interdit que deux sessions partagent un `jti`.
  @@unique([tenantId, tokenHash])
  // Cible des clés étrangères composites — voir `User.@@unique([tenantId, id])`.
  @@unique([tenantId, id])
  // Les deux lectures du module : « les sessions vivantes de cet utilisateur »
  // (déconnexion globale, purge) et le balayage des sessions expirées.
  @@index([tenantId, userId, expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

/// Regroupement de prestations au catalogue — « Soins du visage », « Coiffure ».
///
/// Table à part entière, et non plus la chaîne libre que portait
/// `services.category` : une chaîne recopiée à chaque prestation se renomme
/// prestation par prestation, se faute de frappe (« Massages » / « massage »),
/// et ne peut ni se désactiver ni s'ordonner. Le CRUD réclamé par #24 suppose
/// une ligne à créer, lire, modifier et retirer du catalogue.
///
/// Comme une prestation, une catégorie **ne se supprime pas** : `is_active` la
/// retire du catalogue sans casser les prestations qui la référencent, ni
/// l'historique de reporting qui les compte.
model ServiceCategory {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Unique **par tenant** : deux salons ont chacun droit à leur « coiffure ».
  slug        String  @db.VarChar(80)
  name        String  @db.VarChar(160)
  description String? @db.VarChar(2000)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  services Service[]

  @@unique([tenantId, slug])
  // Cible des clés étrangères composites — voir `User.@@unique([tenantId, id])`.
  @@unique([tenantId, id])
  @@index([tenantId, isActive])
  @@map("service_categories")
}

/// Prestation vendue par l'établissement (nom, durée, prix, catégorie).
model Service {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  slug        String  @db.VarChar(80)
  name        String  @db.VarChar(160)
  description String? @db.VarChar(2000)

  /// Ancienne catégorie en chaîne libre, **plus lue ni écrite** par le module
  /// `catalog` depuis #24 : `categoryId` l'a remplacée. La colonne survit le
  /// temps d'un déploiement — la retirer dans la migration qui cesse de la lire
  /// casserait la version encore en vol pendant un déploiement progressif
  /// (api-module §6). Son retrait fait l'objet d'une issue de suivi.
  ///
  /// Le champ Prisma est renommé, la colonne non : `@map("category")` désigne
  /// toujours `services.category`, et aucun SQL n'accompagne donc ce renommage.
  legacyCategory String? @map("category") @db.VarChar(80)

  /// Catégorie de catalogue. Nullable : une prestation non classée reste
  /// vendable, et imposer une catégorie obligerait à en inventer une avant de
  /// pouvoir créer la première prestation.
  ///
  /// `Restrict` : une catégorie encore portée par une prestation ne se supprime
  /// pas. C'est cohérent avec le reste du schéma — au catalogue on désactive,
  /// on n'efface pas.
  categoryId String?          @map("category_id") @db.Uuid
  category   ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// Durée facturée du soin, en minutes — ce que le client voit et paie.
  durationMinutes Int @map("duration_minutes")

  /// Tampons de part et d'autre du soin, en minutes : préparation de la cabine,
  /// nettoyage, remise en état. Ils ne sont **pas** facturés et n'apparaissent
  /// pas au client, mais le moteur de disponibilité les occupe : le créneau
  /// réellement bloqué sur l'agenda du praticien vaut
  /// `buffer_before + duration + buffer_after`.
  ///
  /// Valeur par défaut `0`, ce qui rend l'ajout de ces colonnes sans effet sur
  /// les prestations déjà en base : le comportement d'avant #24 est exactement
  /// celui de deux tampons nuls.
  bufferBeforeMinutes Int @default(0) @map("buffer_before_minutes")
  bufferAfterMinutes  Int @default(0) @map("buffer_after_minutes")

  /// Prix affiché : entier dans la plus petite unité (3500 = 35,00 €) et code
  /// devise explicite. Jamais de flottant sur un montant.
  priceAmountMinor Int    @map("price_amount_minor")
  priceCurrency    String @map("price_currency") @db.Char(3)

  /// Sortie du catalogue — jamais une suppression : les rendez-vous passés
  /// référencent la prestation, et le reporting doit continuer à savoir ce qui a
  /// été vendu.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignedStaff ServiceStaff[]
  appointments  Appointment[]

  @@unique([tenantId, slug])
  // Cible des clés étrangères composites — voir `User.@@unique([tenantId, id])`.
  @@unique([tenantId, id])
  @@index([tenantId, isActive])
  // Sert « les prestations de cette catégorie », la seule lecture qui filtre sur
  // ce couple — et le contrôle de référencement avant désactivation d'une
  // catégorie.
  @@index([tenantId, categoryId])
  @@map("services")
}

/// Praticien. Distinct de `User` : le compte porte l'identité et les droits, la
/// fiche praticien porte la vitrine publique et l'affectation aux prestations.
/// Un administrateur qui ne prend pas de rendez-vous n'a pas de fiche.
model Staff {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  displayName String  @map("display_name") @db.VarChar(160)
  bio         String? @db.VarChar(2000)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignedServices ServiceStaff[]
  appointments     Appointment[]

  @@unique([tenantId, userId])
  // Cible des clés étrangères composites — voir `User.@@unique([tenantId, id])`.
  @@unique([tenantId, id])
  @@index([tenantId, isActive])
  @@map("staff")
}

/// Affectation N–N « ce praticien pratique cette prestation ».
///
/// Table de jonction **explicite** et non implicite : une relation implicite de
/// Prisma ne porterait pas de `tenant_id`, et il n'y aurait alors rien à quoi
/// accrocher la frontière.
///
/// Porter la colonne ne suffit pourtant pas : les clés étrangères que Prisma
/// génère ici sont mono-colonne (`service_id` → `services(id)`), donc muettes sur
/// le tenant. Ce sont les clés composites `(tenant_id, service_id)` et
/// `(tenant_id, staff_id)`, posées en SQL brut dans la migration, qui rendent
/// réellement impossible d'affecter le praticien d'un salon à la prestation d'un
/// autre.
model ServiceStaff {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  serviceId String  @map("service_id") @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  staffId String @map("staff_id") @db.Uuid
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, serviceId, staffId])
  @@index([tenantId, staffId])
  @@map("service_staff")
}

// ---------------------------------------------------------------------------
// Appointments
// ---------------------------------------------------------------------------

/// Rendez-vous. Le cœur de la boucle de valeur : réserver → confirmer →
/// honorer → encaisser → mesurer.
///
/// `starts_at` et `ends_at` sont des instants UTC. La contrainte d'exclusion
/// anti-double-réservation (`EXCLUDE USING gist`) porte sur ce couple. Elle
/// n'est pas exprimable en Prisma et vit en SQL brut, dans la migration
/// `20260827120000_add_appointment_exclusion` (#31, ADR 0002). Les index posés
/// ici sont ceux dont le moteur de disponibilité et le calendrier admin ont
/// besoin ; celui qui porte la contrainte est créé par la contrainte elle-même.
///
/// `CHECK ("ends_at" > "starts_at")` est déjà en base, dans la migration : un
/// intervalle vide (`ends_at = starts_at`) ne chevauche rien et passerait sous
/// la contrainte d'exclusion sans la déclencher — deux réservations sur le même
/// praticien au même instant.
model Appointment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  clientId String @map("client_id") @db.Uuid
  client   User   @relation("AppointmentClient", fields: [clientId], references: [id], onDelete: Restrict)

  staffId String @map("staff_id") @db.Uuid
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Restrict)

  serviceId String  @map("service_id") @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(6)

  /// L'intervalle occupé, `[starts_at, ends_at)` — **colonne générée**, écrite
  /// par PostgreSQL et par personne d'autre. C'est elle que la contrainte
  /// d'exclusion `appointments_no_overlap` compare avec `&&`.
  ///
  /// `Unsupported` parce que Prisma ne connaît pas les types intervalle : le
  /// champ n'est ni lisible ni écrivable par le client, ce qui est exactement le
  /// régime voulu — `GENERATED ALWAYS` refuserait de toute façon toute écriture.
  /// Il est déclaré ici pour une seule raison, et elle est décisive : sans lui,
  /// le prochain `prisma migrate dev` verrait une colonne inconnue en base et
  /// produirait une migration qui la **retire**, emportant la contrainte avec
  /// elle. Relevé, schéma en main :
  /// `prisma migrate diff` sans ce champ écrit `ALTER TABLE "appointments" DROP
  /// COLUMN "time_range";`.
  ///
  /// Le déclarer supprime ce retrait, mais **pas toute dérive** : Prisma ne sait
  /// pas qu'une colonne est générée, lit son expression comme une valeur par
  /// défaut, et écrit alors `ALTER TABLE "appointments" ALTER COLUMN
  /// "time_range" DROP DEFAULT;` dans toute migration qu'il génère ensuite.
  /// PostgreSQL refuse cette instruction — *column "time_range" of relation
  /// "appointments" is a generated column* —, donc la migration produite par
  /// `npm run db:migrate` ne s'applique pas telle quelle : **cette ligne-là est
  /// à supprimer du fichier généré**, comme le sont déjà les `DROP CONSTRAINT`
  /// des clés étrangères composites, invisibles à Prisma pour la même raison.
  /// L'échec est bruyant et se corrige en une ligne ; le retrait silencieux de
  /// la colonne, lui, emportait la garantie anti-double-réservation.
  ///
  /// Optionnel au sens de Prisma, non nullable en pratique : `starts_at` et
  /// `ends_at` sont `NOT NULL`, donc l'intervalle l'est aussi. L'optionalité est
  /// ce qui permet à Prisma d'omettre le champ des entrées de création.
  timeRange Unsupported("tstzrange")? @map("time_range")

  status AppointmentStatus @default(PENDING)

  /// Prix figé à la réservation : le tarif du catalogue peut changer ensuite,
  /// le montant dû par ce client-là, non.
  priceAmountMinor Int    @map("price_amount_minor")
  priceCurrency    String @map("price_currency") @db.Char(3)

  clientNote String? @map("client_note") @db.VarChar(2000)
  staffNote  String? @map("staff_note") @db.VarChar(2000)

  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason String?   @map("cancellation_reason") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Au plus un encaissement — garanti par `@@unique([tenantId, appointmentId])`
  /// sur `Payment`, pour la même raison que `User.staffProfiles`.
  payments      Payment[]
  notifications Notification[]

  // Cible des clés étrangères composites — voir `User.@@unique([tenantId, id])`.
  @@unique([tenantId, id])
  @@index([tenantId, startsAt])
  @@index([tenantId, staffId, startsAt])
  @@index([tenantId, clientId, startsAt])
  @@index([tenantId, status, startsAt])
  @@map("appointments")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

/// Transaction d'encaissement — rendez-vous ou vente retail au comptoir.
///
/// **Aucune donnée de carte n'atterrit ici** : la tokenisation se fait côté
/// client vers Stripe, et le serveur ne conserve que des références opaques du
/// prestataire. Pas de PAN, pas de cryptogramme, pas de date d'expiration —
/// c'est ce qui maintient le périmètre PCI en SAQ A
/// (.claude/skills/payments-stripe/SKILL.md).
model Payment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Nul pour une vente retail sans rendez-vous. Un rendez-vous n'a qu'un
  /// encaissement : c'est `@@unique([tenantId, appointmentId])` qui le garantit
  /// — PostgreSQL autorise autant de lignes nulles qu'on veut sous une
  /// contrainte d'unicité, donc les ventes retail ne se gênent pas entre elles.
  appointmentId String?      @map("appointment_id") @db.Uuid
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  amountMinor         Int    @map("amount_minor")
  refundedAmountMinor Int    @default(0) @map("refunded_amount_minor")
  currency            String @db.Char(3)

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  /// Références Stripe. `provider_payment_intent_id` est unique **par tenant**,
  /// ce qui rend l'écriture idempotente une fois le tenant connu — mais un
  /// webhook Stripe n'arrive qu'avec `pi_xxx`. Le module `payments` devra donc
  /// résoudre le tenant avant de chercher (métadonnée d'intention, ou point
  /// d'entrée de webhook par établissement) : un index non préfixé de
  /// `tenant_id` n'est pas une option ici.
  providerPaymentIntentId String? @map("provider_payment_intent_id") @db.VarChar(255)
  providerChargeId        String? @map("provider_charge_id") @db.VarChar(255)

  capturedAt DateTime? @map("captured_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, appointmentId])
  @@unique([tenantId, providerPaymentIntentId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, createdAt])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

/// Message émis (confirmation, rappel J-1, avis d'annulation).
///
/// `dedupe_key` porte l'idempotence des envois : le planificateur peut rejouer
/// un rappel, la contrainte d'unicité garantit qu'un client ne reçoit pas deux
/// fois le même SMS. Aucune coordonnée n'est recopiée ici — l'adresse de
/// destination se relit sur le compte au moment de l'envoi, pour ne pas
/// dupliquer de donnée personnelle (CDC §5.1).
model Notification {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  appointmentId String?      @map("appointment_id") @db.Uuid
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  recipientUserId String? @map("recipient_user_id") @db.Uuid
  recipient       User?   @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)

  type    NotificationType
  channel NotificationChannel
  status  NotificationStatus  @default(PENDING)

  /// Clé d'idempotence : « ce message-là, pour ce rendez-vous-là, une fois ».
  dedupeKey String @map("dedupe_key") @db.VarChar(255)

  /// Instant d'envoi voulu — le rappel J-1 est planifié, pas immédiat.
  scheduledFor DateTime? @map("scheduled_for") @db.Timestamptz(6)
  sentAt       DateTime? @map("sent_at") @db.Timestamptz(6)

  attemptCount  Int     @default(0) @map("attempt_count")
  failureReason String? @map("failure_reason") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, scheduledFor])
  @@index([tenantId, appointmentId])
  @@map("notifications")
}
