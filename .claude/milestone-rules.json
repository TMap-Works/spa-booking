  "why": {
    "11": "aucun module Terraform ne s'applique sans backend d'état distant",
    "12": "les sous-réseaux et groupes de sécurité viennent du module network",
    "13": "le service ECS se pose dans le VPC du module network",
    "14": "le rôle OIDC s'écrit dans l'état Terraform distant",
    "15": "la CI ne peut être verte que sur un squelette qui compile",
    "16": "le déploiement de bout en bout assemble tous les modules et la CI",
    "17": "les budgets s'écrivent dans l'état Terraform distant",
    "19": "le schéma Prisma se pose dans le squelette NestJS, pas l'inverse",
    "128": "le harnais teste les décisions de pr_gate.py que #129 réécrit — l'écrire avant figerait le comportement fautif",
    "21": "l'authentification consomme les DTO, l'enumeration de roles et les codes d'erreur de packages/shared",
    "22": "le role MANAGER doit exister dans l'enumeration Prisma UserRole avant d'etre attribuable",
    "202": "la migration ADD VALUE 'MANAGER' ecrit l'enumeration UserRole du schema Prisma",
    "34": "les fenetres de travail se calculent par soustraction : horaires du personnel moins conges et plages bloquees",
    "35": "l'endpoint GET /api/v1/availability expose l'algorithme de calcul des creneaux",
    "36": "l'option premier disponible agrege les creneaux calcules par l'algorithme",
    "39": "le report ecrit dans le service de rendez-vous et soumet le nouveau creneau a la contrainte d'exclusion",
    "40": "l'annulation passe par la machine a etats du service de rendez-vous",
    "37": "la contrainte d'exclusion doit etre en base avant que la creation puisse la violer et traduire le conflit en 409",
    "43": "le socle Next.js d'apps/web n'existe pas encore (ni next, ni app/, ni tsconfig, ni lib/api-client) : #45 le pose, tout autre ecran le reecrirait en conflit",
    "44": "le socle Next.js d'apps/web n'existe pas encore (ni next, ni app/, ni tsconfig, ni lib/api-client) : #45 le pose, tout autre ecran le reecrirait en conflit",
    "46": "le socle Next.js d'apps/web n'existe pas encore (ni next, ni app/, ni tsconfig, ni lib/api-client) : #45 le pose, tout autre ecran le reecrirait en conflit",
    "47": "le socle Next.js d'apps/web n'existe pas encore (ni next, ni app/, ni tsconfig, ni lib/api-client) : #45 le pose, tout autre ecran le reecrirait en conflit",
    "83": "la bascule en production de #83 suppose la production multi-AZ livree par #77",
    "845": "le front lit le type Locale et Tenant.defaultLocale livrés par la fondation données",
    "846": "les écrans se traduisent sur le socle i18n du front (catalogues, résolution, format)",
    "848": "les écrans se traduisent sur le socle i18n du front (catalogues, résolution, format)",
